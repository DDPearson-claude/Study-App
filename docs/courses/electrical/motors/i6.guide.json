\" r=\"3\" class=\"hub\"></circle><circle cx=\"116\" cy=\"74\" r=\"20\" class=\"drum\"></circle><circle cx=\"116\" cy=\"74\" r=\"3\" class=\"hub\"></circle><line x1=\"136\" y1=\"74\" x2=\"136\" y2=\"128\" class=\"rope\"></line><rect x=\"124\" y=\"128\" width=\"24\" height=\"20\" rx=\"2\" class=\"body\"></rect><text x=\"154\" y=\"143\" class=\"lb k-halo\" text-anchor=\"start\">load</text><text x=\"68\" y=\"150\" class=\"lb k-halo\" text-anchor=\"middle\">series motor</text><text x=\"172\" y=\"30\" class=\"hd k-halo\" text-anchor=\"start\">geared, never belted</text><line x1=\"168\" y1=\"58\" x2=\"153\" y2=\"62\" class=\"ldr\"></line><text x=\"172\" y=\"62\" class=\"lb k-halo\" text-anchor=\"start\">gears</text><line x1=\"168\" y1=\"92\" x2=\"135\" y2=\"81\" class=\"ldr\"></line><text x=\"172\" y=\"96\" class=\"lb k-halo\" text-anchor=\"start\">hoist drum</text></svg></div></div></div>","h":183},{"kind":"show","name":"Faults and tests","text":"Safety first: Isolate, lock off and prove dead before you touch the motor or its starter.\n\nIt races: The load came off. Find out why, and check the overspeed trip.\n\nSparking: Worn brushes or a pitted commutator. Poor contact makes them spark.\n\nWill not start: Look for an open field, a lead to earth, or poor brush contact.\n\nTests: Megger the windings to frame. Measure the armature and field resistance.","svg":null,"alt":"isolator: open locked off and tagged megger windings frame brushes commutator","html":"<div class=\"pz\" id=\"pz\"><div id=\"prog\"></div><div id=\"stepbox\" class=\"enter\"><div id=\"fltW\"><svg class=\"fig k-fig\" id=\"flt\" viewBox=\"0 0 340 196\" width=\"100%\" role=\"img\" aria-label=\"The isolator is open, locked off and tagged. A megger is connected from the motor's windings to its frame. Below, the two brushes press on the commutator.\" style=\"--k-fig-max: 493px;\"><text x=\"56\" y=\"16\" class=\"lb k-halo\" text-anchor=\"middle\">isolator: open</text><rect x=\"16\" y=\"24\" width=\"80\" height=\"60\" rx=\"6\" class=\"body\"></rect><path d=\"M0 44H30M0 68H30M30 44L54 32M30 68L54 56M66 44H112M66 68H112\" class=\"w\"></path><circle cx=\"30\" cy=\"44\" r=\"3\" class=\"jn\"></circle><circle cx=\"30\" cy=\"68\" r=\"3\" class=\"jn\"></circle><circle cx=\"66\" cy=\"44\" r=\"3\" class=\"jn\"></circle><circle cx=\"66\" cy=\"68\" r=\"3\" class=\"jn\"></circle><rect x=\"48\" y=\"84\" width=\"16\" height=\"8\" rx=\"2\" class=\"hdl\"></rect><path d=\"M51 104V98a5 5 0 0 1 10 0V104\" class=\"shk\"></path><rect x=\"49\" y=\"103\" width=\"14\" height=\"14\" rx=\"3\" class=\"lock\"></rect><path d=\"M63 110L72 115\" class=\"w\"></path><polygon points=\"74 112 92 112 92 134 70 134 70 116\" class=\"tag\"></polygon><circle cx=\"75\" cy=\"117\" r=\"1.6\" class=\"jn\"></circle><text x=\"98\" y=\"120\" class=\"lb k-halo\" text-anchor=\"start\">locked off</text><text x=\"98\" y=\"136\" class=\"lb k-halo\" text-anchor=\"start\">and tagged</text><rect x=\"178\" y=\"22\" width=\"58\" height=\"36\" rx=\"6\" class=\"body\"></rect><text x=\"207\" y=\"45\" class=\"lb k-halo\" text-anchor=\"middle\">megger</text><rect x=\"266\" y=\"52\" width=\"64\" height=\"56\" rx=\"10\" class=\"body\"></rect><rect x=\"280\" y=\"40\" width=\"28\" height=\"12\" rx=\"2\" class=\"term\"></rect><text x=\"294\" y=\"32\" class=\"lb k-halo\" text-anchor=\"middle\">windings</text><text x=\"298\" y=\"86\" class=\"lb k-halo\" text-anchor=\"middle\">frame</text><path d=\"M236 30H252V46H280M236 50H246V80H266\" class=\"w\"></path><circle cx=\"280\" cy=\"46\" r=\"2.6\" class=\"jn\"></circle><circle cx=\"266\" cy=\"80\" r=\"2.6\" class=\"jn\"></circle><circle cx=\"262\" cy=\"152\" r=\"20\" class=\"drum\"></circle><line x1=\"270.0\" y1=\"152.0\" x2=\"282.0\" y2=\"152.0\" class=\"w\"></line><line x1=\"267.7\" y1=\"157.7\" x2=\"276.1\" y2=\"166.1\" class=\"w\"></line><line x1=\"262.0\" y1=\"160.0\" x2=\"262.0\" y2=\"172.0\" class=\"w\"></line><line x1=\"256.3\" y1=\"157.7\" x2=\"247.9\" y2=\"166.1\" class=\"w\"></line><line x1=\"254.0\" y1=\"152.0\" x2=\"242.0\" y2=\"152.0\" class=\"w\"></line><line x1=\"256.3\" y1=\"146.3\" x2=\"247.9\" y2=\"137.9\" class=\"w\"></line><line x1=\"262.0\" y1=\"144.0\" x2=\"262.0\" y2=\"132.0\" class=\"w\"></line><line x1=\"267.7\" y1=\"146.3\" x2=\"276.1\" y2=\"137.9\" class=\"w\"></line><circle cx=\"262\" cy=\"152\" r=\"8\" class=\"drum\"></circle><rect x=\"232\" y=\"146\" width=\"10\" height=\"12\" rx=\"1.5\" class=\"brush\"></rect><rect x=\"282\" y=\"146\" width=\"10\" height=\"12\" rx=\"1.5\" class=\"brush\"></rect><path d=\"M220 152H232M292 152H304\" class=\"w\"></path><text x=\"237\" y=\"136\" class=\"lb k-halo\" text-anchor=\"middle\">brushes</text><text x=\"262\" y=\"190\" class=\"lb k-halo\" text-anchor=\"middle\">commutator</text></svg></div></div></div>","h":214},{"kind":"example","name":"Find the fault","task":"A ventilation fan runs on a DC series motor. One day the motor suddenly races and trips on overspeed. What is the most likely fault?","answer":"The drive belt has snapped","why":"","svg":null,"alt":"A snapped belt leaves the motor with no load. The current fell, the field weakened and the speed climbed. The fix is a direct or geared drive, not a new belt.","input":"pick","options":["The field winding has gone open circuit","The drive belt has snapped","The brushes are worn"],"html":"<div class=\"pz\" id=\"pz\"><div id=\"prog\"></div><div id=\"stepbox\" class=\"enter\"><div class=\"picks\" id=\"picks\"></div><div class=\"fb ok\" id=\"fb\" aria-live=\"polite\"><p>A snapped belt leaves the motor with no load. The current fell, the field weakened and the speed climbed. The fix is a direct or geared drive, not a new belt.</p></div></div></div>","h":198}]}
