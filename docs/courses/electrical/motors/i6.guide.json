177.5L289.6 177.7L291.1 177.8L292.7 177.9L294.2 178.0L295.8 178.1L297.3 178.3L298.9 178.4L300.4 178.5L301.9 178.6L303.5 178.7L305.0 178.8L306.6 178.9L308.1 179.1L309.7 179.2L311.2 179.3L312.7 179.4L314.3 179.5L315.8 179.6L317.4 179.7L318.9 179.8L320.5 179.9L322.0 180.0\" class=\"sp\"></path><path d=\"M52.0 197.5L53.5 197.3L55.1 197.1L56.6 196.9L58.2 196.6L59.7 196.4L61.3 196.2L62.8 195.9L64.3 195.6L65.9 195.4L67.4 195.1L69.0 194.8L70.5 194.5L72.1 194.2L73.6 193.9L75.1 193.6L76.7 193.3L78.2 192.9L79.8 192.6L81.3 192.3L82.9 191.9L84.4 191.5L85.9 191.2L87.5 190.8L89.0 190.4L90.6 190.0L92.1 189.6L93.7 189.2L95.2 188.8L96.7 188.3L98.3 187.9L99.8 187.5L101.4 187.0L102.9 186.5L104.5 186.1L106.0 185.6L107.5 185.1L109.1 184.6L110.6 184.1L112.2 183.6L113.7 183.1L115.3 182.6L116.8 182.0L118.3 181.5L119.9 181.0L121.4 180.4L123.0 179.8L124.5 179.3L126.1 178.7L127.6 178.1L129.1 177.5L130.7 176.9L132.2 176.3L133.8 175.7L135.3 175.0L136.9 174.4L138.4 173.8L139.9 173.1L141.5 172.4L143.0 171.8L144.6 171.1L146.1 170.4L147.7 169.7L149.2 169.0L150.7 168.3L152.3 167.6L153.8 166.9L155.4 166.1L156.9 165.4L158.5 164.7L160.0 163.9L161.5 163.1L163.1 162.4L164.6 161.6L166.2 160.8L167.7 160.0L169.3 159.2L170.8 158.4L172.3 157.6L173.9 156.7L175.4 155.9L177.0 155.1L178.5 154.2L180.1 153.3L181.6 152.5L183.1 151.6L184.7 150.7L186.2 149.8L187.8 148.9L189.3 148.0L190.9 147.1L192.4 146.2L193.9 145.2L195.5 144.3L197.0 143.4L198.6 142.4L200.1 141.4L201.7 140.5L203.2 139.5L204.7 138.5L206.3 137.5L207.8 136.5L209.4 135.5L210.9 134.5L212.5 133.4L214.0 132.4L215.5 131.4L217.1 130.3L218.6 129.2L220.2 128.2L221.7 127.1L223.3 126.0L224.8 124.9L226.3 123.8L227.9 122.7L229.4 121.6L231.0 120.5L232.5 119.3L234.1 118.2L235.6 117.1L237.1 115.9L238.7 114.7L240.2 113.6L241.8 112.4L243.3 111.2L244.9 110.0L246.4 108.8L247.9 107.6L249.5 106.4L251.0 105.1L252.6 103.9L254.1 102.7L255.7 101.4L257.2 100.1L258.7 98.9L260.3 97.6L261.8 96.3L263.4 95.0L264.9 93.7L266.5 92.4L268.0 91.1L269.5 89.8L271.1 88.4L272.6 87.1L274.2 85.8L275.7 84.4L277.3 83.0L278.8 81.7L280.3 80.3L281.9 78.9L283.4 77.5L285.0 76.1L286.5 74.7L288.1 73.3L289.6 71.8L291.1 70.4L292.7 69.0L294.2 67.5L295.8 66.0L297.3 64.6L298.9 63.1L300.4 61.6L301.9 60.1L303.5 58.6L305.0 57.1L306.6 55.6L308.1 54.1L309.7 52.5L311.2 51.0L312.7 49.5L314.3 47.9L315.8 46.3L317.4 44.8L318.9 43.2L320.5 41.6L322.0 40.0\" class=\"tq\"></path><text x=\"105.8\" y=\"116.6\" class=\"lb k-halo\" text-anchor=\"start\">speed</text><text x=\"244.9\" y=\"98.0\" class=\"lb k-halo\" text-anchor=\"end\">torque</text><line x1=\"52.0\" y1=\"200\" x2=\"52.0\" y2=\"197.5\" class=\"gd\"></line><circle cx=\"52.0\" cy=\"40.0\" r=\"7\" class=\"dotS hot\"></circle><circle cx=\"52.0\" cy=\"197.5\" r=\"4.5\" class=\"dotT\"></circle></svg><div class=\"k-readouts\" id=\"outs\"><div class=\"k-readout\" data-id=\"rdField\" style=\"flex-basis: min(100%, 132px);\"><span class=\"k-readout-label\">Field, per unit</span><span class=\"k-readout-value\" style=\"\"><span class=\"k-num\">0.25</span></span></div><div class=\"k-readout\" data-id=\"rdTorque\" style=\"flex-basis: min(100%, 132px);\"><span class=\"k-readout-label\">Torque, per unit</span><span class=\"k-readout-value\" style=\"\"><span class=\"k-num\">0.06</span></span></div><div class=\"k-readout hot\" data-id=\"rdSpeed\" style=\"flex-basis: min(100%, 132px);\"><span class=\"k-readout-label\">Speed, per unit</span><span class=\"k-readout-value\" style=\"\"><span class=\"k-num\">4.00</span></span></div></div><p class=\"say\" id=\"say\">At 0.25 of full-load current the field is 0.25. Torque is field times current, so it is 0.06. The back-emf must still match the supply. In a weaker field the armature must spin faster to make it. So the speed is 4.00. That is past the danger line. With no load it keeps climbing: runaway.</p><div class=\"work\" id=\"work\"><p class=\"wh\">Worked from the rule</p><p class=\"wl\">At 2.00: field 2.00, torque 2.00 × 2.00 = 4.00, speed 1 ÷ 2.00 = 0.50.</p><p class=\"wl\">At 0.50: field 0.50, torque 0.50 × 0.50 = 0.25, speed 1 ÷ 0.50 = 2.00.</p><p class=\"wl\">At 0.25: field 0.25, torque 0.25 × 0.25 = 0.0625, about 0.06, speed 1 ÷ 0.25 = 4.00.</p><p class=\"wl\">The speed crosses the red line near 0.33, a third of full-load current.</p></div></div></div></div></div>","h":1186},{"kind":"example","name":"Check","task":"A hoist is lifting on a DC series motor. The coupling shears and the load comes off. What does the motor do?","answer":"Its speed climbs and keeps climbing","why":"","svg":null,"alt":"With no load it speeds up, and the current falls. Less current means a weaker field. In a weaker field the armature must spin faster to make the same back-emf. So it speeds up again, and keeps climbing. That is runaway. It is why the motor must have overspeed protection.","input":"pick","options":["It slows and stops: it has nothing to drive","It speeds up a little, then holds a steady speed","Its speed climbs and keeps climbing"],"html":"<div class=\"pz\" id=\"pz\"><div id=\"prog\"></div><div id=\"stepbox\" class=\"enter\"><div class=\"picks\" id=\"picks\"></div><div class=\"fb ok\" id=\"fb\" aria-live=\"polite\"><p>With no load it speeds up, and the current falls. Less current means a weaker field. In a weaker field the armature must spin faster to make the same back-emf. So it speeds up again, and keeps climbing. That is <mark>runaway</mark>. It is why the motor must have overspeed protection.</p></div></div></div>","h":270},{"kind":"show","name":"How it behaves","text":"Starting torque: Very high. It goes with current squared until the iron saturates, then with current alone.\n\nSpeed: Poor regulation. It changes a lot with load. Unloaded, it climbs dangerously.\n\nStarting current: Only the resistance limits it. 260 V across a 0.4 Ω armature gives 650 A, about twelve times full load. The field's resistance trims that a little. So start it through a starting resistance.\n\nReversing: Swap the field or the armature leads, not both. Swapping the supply leads does not reverse it.","svg":null,"alt":"speed danger line: an example, not a maker's 0 1.00 2.00 3.00 4.00 0.25 0.50 1.00 1.50 2.00 Torque and speed, per unit Load current, per unit speed torque sketch from the ideal rule","html":"<div class=\"pz\" id=\"pz\"><div id=\"prog\"></div><div id=\"stepbox\" class=\"enter\"><div id=\"behW\"><svg class=\"fig k-fig\" id=\"beh\" viewBox=\"0 0 340 266\" width=\"100%\" role=\"img\" aria-label=\"A sketch from the ideal rule: torque and speed, per unit, against load current from 0.25 to 2.00. Torque rises as the current squared. Speed falls as one over the current, climbing into a red band above 3.00 at light load. The band covers the light-load half, up to full load.\" style=\"--k-fig-max: 493px;\"><line x1=\"52\" y1=\"160\" x2=\"322\" y2=\"160\" class=\"grid\"></line><line x1=\"52\" y1=\"120\" x2=\"322\" y2=\"120\" class=\"grid\"></line><line x1=\"52\" y1=\"80\" x2=\"322\" y2=\"80\" class=\"grid\"></line><line x1=\"52\" y1=\"40\" x2=\"322\" y2=\"40\" class=\"grid\"></line><rect x=\"52\" y=\"40\" width=\"115.7\" height=\"40\" class=\"band\"></rect><line x1=\"52\" y1=\"80\" x2=\"167.7\" y2=\"80\" class=\"dl\"></line><text x=\"72\" y=\"56\" class=\"wt k-halo\" text-anchor=\"start\">speed danger line:</text><text x=\"72\" y=\"72\" class=\"wt k-halo\" text-anchor=\"start\">an example, not a maker's</text><path d=\"M52 36V200H322\" class=\"ax\"></path><text x=\"44\" y=\"204.5\" class=\"lb k-halo\" text-anchor=\"end\">0</text><text x=\"44\" y=\"164.5\" class=\"lb k-halo\" text-anchor=\"end\">1.00</text><text x=\"44\" y=\"124.5\" class=\"lb k-halo\" text-anchor=\"end\">2.00</text><text x=\"44\" y=\"84.5\" class=\"lb k-halo\" text-anchor=\"end\">3.00</text><text x=\"44\" y=\"44.5\" class=\"lb k-halo\" text-anchor=\"end\">4.00</text><line x1=\"52\" y1=\"200\" x2=\"52\" y2=\"205\" class=\"ax\"></line><text x=\"52\" y=\"220\" class=\"lb k-halo\" text-anchor=\"middle\">0.25</text><line x1=\"90.57142857142857\" y1=\"200\" x2=\"90.57142857142857\