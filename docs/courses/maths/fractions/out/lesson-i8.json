 "interactive": {
  "html": "<!-- kind: quantity -->\n<style>\n  .ct .edge { fill: none; stroke: var(--k-strong); stroke-width: 1.5; }\n  .ct .odd { fill: var(--k-accent2); }\n  .ct .even { fill: var(--k-fill1); }\n  .ct .hatchbg { fill: var(--k-sunk); }\n  .ct .hatch { fill: url(#ct-hatch); }\n  .ct .keyt { font: 13px var(--k-font); fill: var(--k-ink); }\n  .ct .len { font: 700 15px var(--k-font); fill: var(--k-on-accent2); }\n  .ct .len.above { fill: var(--k-accent2); }\n  .ct .len .frac { font-size: 13px; }\n  .ct .len .slash { font-size: 14px; font-weight: 400; }\n  .ct .line { stroke: var(--k-ink); stroke-width: 1.5; }\n  .ct .tick { stroke: var(--k-muted); stroke-width: 1; }\n  .ct .tick.metre { stroke: var(--k-ink); stroke-width: 1.5; }\n  .ct .num { font: 14px var(--k-font); fill: var(--k-ink); }\n  .ct .end { fill: var(--k-accent2); }\n  .ct .sum { font: 17px var(--k-font); fill: var(--k-ink); }\n  .ct .sum .frac { font-size: 14px; }\n  .ct .sum .slash { font-size: 15px; }\n  .ct .sum .ans { font-weight: 800; font-size: 18px; fill: var(--k-accent2); }\n  .ct .grab { fill: transparent; cursor: ew-resize; }\n</style>\n\n<p class=\"lead\">An example run: 6 m of cable, cut from its left end into equal tails, with a line beneath marking the metres and the quarters.</p>\n\n<svg class=\"ct\" id=\"scene\" viewBox=\"0 0 340 164\" width=\"100%\" role=\"img\" aria-label=\"\">\n  <defs>\n    <pattern id=\"ct-hatch\" patternUnits=\"userSpaceOnUse\" width=\"7\" height=\"7\" patternTransform=\"rotate(45)\">\n      <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"7\" stroke=\"var(--k-accent2)\" stroke-width=\"1.6\"/>\n    </pattern>\n  </defs>\n  <g id=\"key\">\n    <rect class=\"odd\" x=\"20\" y=\"4\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <rect class=\"even\" x=\"33\" y=\"4\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <text class=\"keyt\" x=\"50\" y=\"14\">whole tails, shaded in turn</text>\n    <g id=\"keyleft\">\n      <rect class=\"hatchbg\" x=\"20\" y=\"21\" width=\"12\" height=\"12\" rx=\"2\"/>\n      <rect class=\"hatch\" x=\"20\" y=\"21\" width=\"12\" height=\"12\" rx=\"2\"/>\n      <text class=\"keyt\" x=\"37\" y=\"31\">part of a tail: the cable left over</text>\n    </g>\n  </g>\n  <text class=\"len above\" id=\"lenAbove\" x=\"20\" y=\"46\"></text>\n  <g id=\"bar\"></g>\n  <g id=\"scale\"></g>\n  <g id=\"sum\"></g>\n  <rect class=\"grab\" id=\"grab\" x=\"20\" y=\"42\" width=\"300\" height=\"50\"/>\n</svg>\n<div class=\"k-controls\" id=\"controls\"></div>\n<p class=\"say\" id=\"say\"></p>\n<div class=\"k-readouts\" id=\"outs\"></div>\n\n<div id=\"plot\"></div>\n<p class=\"caption\">Count the run in quarters: 24 quarters ÷ the quarters in one tail is the tails that fit.</p>\n\n<script>\n  // The run: 6 m of cable. A quarter of a metre is one of 4 that make a metre, so the run holds 6 × 4 = 24 quarters.\n  const RUN = 6, PER_M = 4, QUARTERS = RUN * PER_M;\n  const SRC_HOWMANY = 'https://www.mathsisfun.com/fractions_division.html';   // [10]\n  const SRC_RECIP = 'https://www.khanacademy.org/math/get-ready-for-7th-grade/xa46d6dd638f86863:get-ready-for-negative-number-operations/xa46d6dd638f86863:dividing-fractions/v/meaning-of-the-reciprocal';   // [4]\n\n  // The rule: a tail of q quarters fits (metres × 4) ÷ q times, because each tail takes q of the quarters.\n  const fitsIn = (metres, q) => (metres * PER_M) / q;\n  const tailM = (q) => q / PER_M;                               // the tail's length in metres\n  const wholeOf = (q) => Math.floor(fitsIn(RUN, q) + 1e-9);     // whole tails that fit\n  const leftOf = (q) => RUN - wholeOf(q) * tailM(q);            // cable the whole tails do not use\n\n  // The tail's length as a fraction of a metre in its simplest name: 1/4, 1/2, 3/4, 1, 1 1/4, 1 1/2, 1 3/4, 2.\n  const PART = { 1: '1/4', 2: '1/2', 3: '3/4' };\n  const GLYPH = { 1: '¼', 2: '½', 3: '¾' };\n  const nameParts = (q) => ({ whole: Math.floor(q / PER_M), part: PART[q % PER_M] || '' });\n  // In running text (the slider, the sentence) the part is a single glyph, so 1¼ cannot read as 11/4.\n  const nameText = (q) => { const n = nameParts(q); return (n.whole ? String(n.whole) : '') + (GLYPH[q % PER_M] || ''); };\n  // On the drawing the part is set as a fraction, its top raised and its bottom lowered either side of the\n  // slash, after a gap from the whole, so 1 1/2 can never read as 11/2.\n  const nameSpans = (q, after) => {\n    const n = nameParts(q), out = [];\n    if (n.whole) out.push(K.svg('tspan', {}, String(n.whole)));\n    if (n.part) {\n      const [top, bottom] = n.part.split('/');\n      out.push(K.svg('tspan', { class: 'frac', dx: n.whole ? 5 : 0, dy: -5 }, top));\n      out.push(K.svg('tspan', { class: 'slash', dy: 5 }, '/'));\n      out.push(K.svg('tspan', { class: 'frac', dy: 3 }, bottom));\n    }\n    out.push(K.svg('tspan', { dx: 3, dy: n.part ? -3 : 0 }, after));\n    return out;\n  };\n  // A count written as the explanation writes it: whole when whole, otherwise to two decimals (4.8, 3.43).\n  const count = (v) => String(Math.round(v * 100) / 100);\n  const metres = count;\n\n  // The drawing: 0 at x = 20, 6 m at x = 320, so a metre is 50 units and a quarter 12.5.\n  const X0 = 20, X1 = 320, M = (X1 - X0) / RUN, Q = M / PER_M;\n  const xAt = (m) => X0 + m * M;\n  const BAR_Y = 50, BAR_H = 34, LINE_Y = 106, NUM_Y = 126, SUM_Y = 152;\n\n  K.control({ id: 'tailQuarters', label: 'Tail length (quarters of a metre)', min: 1, max: 8, step: 1, value: 8, snap: [3, 4],\n    fmt: (q) => q + (q === 1 ? ' quarter' : ' quarters') + ' = ' + nameText(q) + ' m', into: '#controls' });\n  K.stage('#scene', '#controls');\n  K.readout({ id: 'leftOver', label: 'Cable left over', unit: 'm', decimals: 2, into: '#outs' });\n\n  K.model((p) => ({ tailsFit: fitsIn(RUN, p.tailQuarters), leftOver: leftOf(p.tailQuarters) }));\n\n  // Drag along the bar to set where the first cut falls.\n  K.drag('#grab', { control: 'tailQuarters', toValue: (x) => K.clamp(Math.round((x - X0) / Q), 1, 8) });\n\n  // The line beneath, drawn once: a mark at every metre, a fainter one at each quarter.\n  const scale = document.getElementById('scale');\n  scale.appendChild(K.svg('line', { class: 'line', x1: X0, y1: LINE_Y, x2: X1, y2: LINE_Y }));\n  for (let k = 0; k <= QUARTERS; k++) {\n    const metre = k % PER_M === 0;\n    scale.appendChild(K.svg('line', { class: 'tick' + (metre ? ' metre' : ''), x1: xAt(k / PER_M), y1: LINE_Y, x2: xAt(k / PER_M), y2: LINE_Y + (metre ? 9 : 5) }));\n  }\n  for (let m = 0; m <= RUN; m++) scale.appendChild(K.svg('text', { class: 'num', x: xAt(m), y: NUM_Y, 'text-anchor': m === RUN ? 'end' : m === 0 ? 'start' : 'middle' }, m === RUN ? '6 m' : String(m)));\n\n  // The plot: one dot for every setting of the slider, the current one picked out, a level line at 6.\n  const DOTS = [];\n  for (let q = 1; q <= 8; q++) DOTS.push([q, fitsIn(RUN, q)]);\n  const plot = K.plot('#plot', {\n    x: { min: 0.5, max: 8.5, ticks: [1, 2, 3, 4, 5, 6, 7, 8], label: 'Tail length (quarters of a metre)' },\n    y: { min: 0, max: 25, ticks: [0, 6, 12, 18, 24], label: 'Tails that fit' },\n    height: 220,\n    label: 'Tails that fit against tail length: 24 at 1 quarter, falling steeply to 6 at 4 quarters, where the dot sits on the level line at 6, then flattening to 3 at 8 quarters',\n  });\n\n  const svg = document.getElementById('scene');\n  const g = (id) => { const e = document.getElementById(id); e.textContent = ''; return e; };\n\n  function draw(p, o) {\n    const q = p.tailQuarters, len = tailM(q), whole = wholeOf(q), w = len * M;\n\n    // The bar: whole tails from the left end, shaded in turn; the part of the next tail that fits, hatched.\n    const bar = g('bar');\n    for (let i = 0; i < whole; i++) bar.appendChild(K.svg('rect', { class: i % 2 ? 'even' : 'odd', x: xAt(i * len), y: BAR_Y, width: w, height: BAR_H }));\n    if (o.leftOver > 1e-9) {\n      const x = xAt(whole * len), lw = xAt(RUN) - x;\n      bar.appendChild(K.svg('rect', { class: 'hatchbg', x, y: BAR_Y, width: lw, height: BAR_H }));\n      bar.appendChild(K.svg('rect', { class: 'hatch', x, y: BAR_Y, width: lw, height: BAR_H }));\n    }\n    bar.appendChild(K.svg('rect', { class: 'edge', x: X0, y: BAR_Y, width: X1 - X0, height: BAR_H, rx: 2 }));\n    document.getElementById('keyleft').style.display = o.leftOver > 1e-9 ? '' : 'none';\n\n    // The first tail carries its length; too narrow for it, the length sits just above the tail.\n    const inside = K.svg('text', { class: 'len', x: X0 + w / 2, y: BAR_Y + 22, 'text-anchor': 'middle' }, ...nameSpans(q, 'm'));\n    bar.appendChild(inside);\n    const above = document.getElementById('lenAbove');\n    above.textContent = '';\n    if (inside.getComputedTextLength() + 6 > w) {\n      bar.removeChild(inside);\n      nameSpans(q, 'm').forEach((t) => above.appendChild(t));\n    }\n\n    // The end of each tail, marked on the line beneath.\n    Array.prototype.forEach.call(scale.querySelectorAll('.end'), (e) => e.remove());\n    for (let i = 1; i <= whole; i++) scale.appendChild(K.svg('circle', { class: 'end', cx: xAt(i * len), cy: LINE_Y, r: 3.5 }));\n\n    // The division the picture shows: the run ÷ the tail = the tails that fit.\n    const sum = g('sum');\n    const tails = count(o.tailsFit);\n    sum.appendChild(K.svg('text', { class: 'sum', x: 170, y: SUM_Y, 'text-anchor': 'middle' },\n      '6 ÷ ', ...nameSpans(q, '= '), K.svg('tspan', { class: 'ans' }, tails + (o.tailsFit === 1 ? ' tail' : ' tails'))));\n\n    plot.draw({\n      series: [{ points: DOTS, dots: true, label: 'Tails that fit' }],\n      lines: [{ y: RUN, label: 'the run’s 6 m' }],\n      marks: [{ x: q, y: o.tailsFit, guides: true }],\n    });\n\n    const name = nameText(q) + ' m';\n    svg.setAttribute('aria-label', 'A 6 m run of cable cut from the left end into ' + name + ' tails: ' + whole + ' whole tail' + (whole === 1 ? '' : 's') +\n      (o.leftOver > 1e-9 ? ' and a hatched part of a tail, ' + K.fmt(o.leftOver, { decimals: 2 }) + ' m' + ' of cable left over' : ' using the whole run') +\n      ', each tail’s end marked on the line beneath. The division reads 6 ÷ ' + name.replace(' m', '') + ' = ' + tails + '.');\n\n    // The sentence: the counting in quarters, then the division it answers and why the count beats or trails the 6.\n    let s = 'A quarter of a metre fits 4 times in a metre, so 6 × 4 = 24 quarters fit in the run. Each ' + name + ' tail takes ' + q + ' of them, so 24 ÷ ' + q + ' = ' + tails + ' tail' + (o.tailsFit === 1 ? '' : 's') + ' fit';\n    if (o.leftOver > 1e-9) {\n      s += ': ' + whole + ' whole tails use ' + metres(whole * len) + ' m, and the ' + K.fmt(o.leftOver, { decimals: 2 }) + ' m' + ' left over is ' + (QUARTERS % q) + '/' + q + ' of a tail, hatched';\n    } else {\n      s += ', using all 6 m';\n    }\n    s += '. So 6 ÷ ' + nameText(q) + ' = ' + tails + ': ';\n    if (q < PER_M) s += 'more tails than metres, because a tail shorter than a metre fits more than once in every metre.';\n    else if (q === PER_M) s += 'one tail for every metre, because the tail is exactly a metre long.';\n    else s += 'fewer tails than metres, because a tail longer than a metre fits less than once in each metre.';\n    if (!K.moved) s += ' Shorten the tail below 1 m and the count climbs past 6.';\n    document.getElementById('say').textContent = s;\n  }\n  K.update(draw);\n\n  // Known answers, worked out by hand from the rule.\n  K.check('At 8 quarters the tail is 2 m and 24 ÷ 8 = 3 tails fit, the puzzle’s first cut; at 3 quarters, 3/4 m, 24 ÷ 3 = 8, its second; both use all 6 m', () => {\n    const a = K.at({ tailQuarters: 8 }), b = K.at({ tailQuarters: 3 });\n    return K.near(tailM(8), 2, 1e-9) && K.near(a.tailsFit, 3, 1e-9) && K.near(a.leftOver, 0, 1e-9) &&\n      K.near(tailM(3), 0.75, 1e-9) && K.near(b.tailsFit, 8, 1e-9) && K.near(b.leftOver, 0, 1e-9) && K.near(8 * 0.75, 6, 1e-9);\n  });\n  K.check('At 4 quarters the tail is 1 m and 24 ÷ 4 = 6 tails fit, one per metre; every shorter tail fits more than 6 times, every longer one fewer', () => {\n    if (!K.near(K.at({ tailQuarters: 4 }).tailsFit, 6, 1e-9)) return false;\n    for (let q = 1; q <= 8; q++) {\n      const t = K.at({ tailQuarters: q }).tailsFit;\n      if (q < 4 && !(t > 6) || q > 4 && !(t < 6)) return false;\n    }\n    return true;\n  });\n  K.check('Where 24 does not divide evenly: at 5 quarters 24 ÷ 5 = 4.8, four whole tails of 1 1/4 m use 5 m and 1 m is left; at 7, about 3.43, three tails of 1 3/4 m use 5.25 m and 0.75 m is left', () => {\n    const a = K.at({ tailQuarters: 5 }), b = K.at({ tailQuarters: 7 });\n    return K.near(a.tailsFit, 4.8, 1e-9) && wholeOf(5) === 4 && K.near(4 * 1.25, 5, 1e-9) && K.near(a.leftOver, 1, 1e-9) && count(a.tailsFit) === '4.8' &&\n      K.near(b.tailsFit, 24 / 7, 1e-9) && count(b.tailsFit) === '3.43' && wholeOf(7) === 3 && K.near(3 * 1.75, 5.25, 1e-9) && K.near(b.leftOver, 0.75, 1e-9);\n  });\n  K.check('\"3 divided by 1/4\" asks how many quarters are in 3, which is 12', () => K.near(fitsIn(3, 1), 12, 1e-9) && K.near(3 * 4, 12, 1e-9), { source: SRC_HOWMANY });\n  K.check('The reciprocal counts how many times the fraction fits into 1: a 3/4 m tail fits 4/3 times, about 1.33, into 1 m', () =>\n    K.near(fitsIn(1, 3), 4 / 3, 1e-9) && K.near(4 / 3, 1.33, 0.005), { source: SRC_RECIP });\n  K.check('The dots fall steeply then flatten: from 1 quarter to 2 the count drops by 12, from 7 to 8 by about 0.43; and whole tails plus the cable left over always give the 6 m back', () => {\n    if (!K.near(fitsIn(RUN, 1) - fitsIn(RUN, 2), 12, 1e-9) || !K.near(fitsIn(RUN, 7) - fitsIn(RUN, 8), 0.43, 0.005)) return false;\n    for (let q = 1; q <= 8; q++) {\n      const o = K.at({ tailQuarters: q });\n      if (!K.near(wholeOf(q) * tailM(q) + o.leftOver, RUN, 1e-9) || !(o.leftOver >= 0 && o.leftOver < tailM(q))) return false;\n    }\n    return true;\n  });\n\n  K.ready();\n</script>\n",
