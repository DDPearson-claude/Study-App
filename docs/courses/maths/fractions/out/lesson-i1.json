 "interactive": {
  "html": "<!-- kind: concept -->\n<style>\n  [hidden] { display: none !important; }\n  .pz { max-width: 30rem; }\n  .pz > * + * { margin-top: 14px; }\n  /* The stepper is the page's step control: its dots are the progress bar; Back and Continue are below. */\n  .pz .k-stepper { gap: 0; }\n  .pz .k-stepper .k-label, .pz .k-stepper-nav { display: none; }\n  .pz .count { margin-top: 10px; }\n  .task { font-size: 1.2rem; font-weight: 700; line-height: 1.5; margin-top: 4px; }\n  .fr { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; line-height: 1.1; font-weight: 700; margin: 0 .1em; font-size: .9em; }\n  .fr .n { border-bottom: 2px solid currentColor; padding: 0 .18em; }\n  .fr .d { padding: 0 .18em; }\n  .scene { display: block; width: 100%; }\n  .scene .pc { fill: var(--k-panel); stroke: var(--k-strong); stroke-width: 2; cursor: pointer; transition: fill .15s ease; }\n  .scene .pc.on { fill: var(--k-accent2); }\n  .scene .pc.locked { cursor: default; }\n  .scene .pc:focus { outline: none; }\n  .scene .pc:focus-visible, .scene .hit:focus-visible { stroke: var(--k-accent); stroke-width: 4; }\n  .scene .edge { fill: none; stroke: var(--k-strong); stroke-width: 2.5; }\n  .scene .blank { fill: var(--k-panel); stroke: var(--k-strong); stroke-width: 2.5; }\n  .scene .axis { stroke: var(--k-ink); stroke-width: 2.5; stroke-linecap: round; }\n  .scene .tick { stroke: var(--k-ink); stroke-width: 2; }\n  .scene .num { font: 700 16px var(--k-font); fill: var(--k-ink); }\n  .scene .lab { font: 700 15px var(--k-font); fill: var(--k-ink); }\n  .scene .fbar { stroke: var(--k-ink); stroke-width: 1.5; }\n  .scene .hit { fill: var(--k-bg); fill-opacity: 0; cursor: pointer; }\n  .scene .hit.locked { cursor: default; }\n  .scene .dot { fill: var(--k-accent2); stroke: var(--k-bg); stroke-width: 2.5; }\n  .scene .hop { fill: none; stroke: var(--k-accent); stroke-width: 2; }\n  .scene .mlab { font: 700 15px var(--k-font); fill: var(--k-accent2); }\n  .scene .mbar { stroke: var(--k-accent2); stroke-width: 1.5; }\n  .row { display: flex; flex-wrap: wrap; gap: 10px; }\n  .row .k-btn { flex: 1 1 7rem; }\n  .picks .k-btn { font-size: 1.15rem; min-height: 56px; }\n  .picks .k-btn[aria-pressed=\"true\"] { background: var(--k-accent2); color: var(--k-on-accent2); border-color: var(--k-accent2); }\n  .fb { font-weight: 700; min-height: 1.5em; margin-top: 10px; }\n  .fb.right { color: var(--k-good); }\n  .fb.wrong { color: var(--k-ink); }\n  .why { line-height: 1.6; }\n  .done { line-height: 1.6; }\n  .done strong { color: var(--k-accent2); }\n</style>\n\n<p class=\"lead\">Shapes and a number line, one small puzzle at a time.</p>\n\n<div class=\"pz\" id=\"pz\">\n  <div id=\"prog\"></div>\n  <p class=\"k-label count\" id=\"count\"></p>\n  <p class=\"task\" id=\"task\"></p>\n  <svg class=\"scene\" id=\"scene\" viewBox=\"0 0 340 80\" width=\"100%\" role=\"img\" aria-label=\"\"></svg>\n  <div class=\"row picks\" id=\"picks\"></div>\n  <div class=\"row acts\" id=\"acts\"></div>\n  <p class=\"fb\" id=\"fb\" aria-live=\"polite\"></p>\n  <div class=\"note why\" id=\"why\" hidden></div>\n  <div class=\"row nav\" id=\"nav\"></div>\n  <div class=\"panel done\" id=\"done\" hidden>\n    <p>All six puzzles done.</p>\n    <p><strong id=\"finish\"></strong></p>\n    <div class=\"row\" id=\"again\"></div>\n  </div>\n</div>\n\n<p class=\"caption\">Every bar and square here is one whole.</p>\n\n<script>\n  // ---------- the six puzzles ----------\n  const STEPS = [\n    { name: 'Colour three quarters', kind: 'bar', bars: 1, per: 4, want: 3,\n      task: 'Colour 3/4 of the bar.',\n      why: 'The bottom number, 4, cuts the bar into four equal pieces. The top number, 3, says to colour three of them.',\n      hint: 'Not quite. Count the shaded pieces.', empty: 'Tap a piece to colour it.' },\n    { name: 'Colour half the square', kind: 'square',\n      task: 'Colour 1/2 of the square.',\n      why: 'Half means half the space, not half the pieces. The big piece is half on its own, and so are the two small ones together.',\n      hint: 'Not quite. Compare the space, not the number of pieces.', empty: 'Tap a piece to colour it.' },\n    { name: 'Find 3/4 on the line', kind: 'line', wholes: 1, want: 3,\n      task: 'Tap where 3/4 goes on the line.',\n      why: 'Count three quarter-steps from 0. Where you stop is the number 3/4.',\n      hint: 'Not quite. Count the quarter-steps from 0.', empty: 'Tap the line to place a mark.' },\n    { name: 'Which is bigger?', kind: 'compare',\n      task: 'Which is bigger: 5/8 or 3/4?',\n      why: 'Bigger numbers don\\'t make a bigger fraction. Five eighths is a little less than three quarters.',\n      hint: 'Not quite. Compare the space each one fills.', empty: 'Tap one of the two answers.' },\n    { name: 'Colour seven quarters', kind: 'bar', bars: 2, per: 4, want: 7,\n      task: 'Colour 7/4.',\n      why: 'Four quarters fill one whole bar. Three more go into the next, so 7/4 is one whole and three quarters, written 1 3/4.',\n      hint: 'Not quite. Count the shaded pieces.', empty: 'Tap a piece to colour it.' },\n    { name: 'Find 7/4 on the line', kind: 'line', wholes: 2, want: 7,\n      task: 'Tap where 7/4 goes on the line.',\n      why: 'Seven quarter-steps from 0 takes you past 1 and three steps more.',\n      hint: 'Not quite. Count the quarter-steps from 0.', empty: 'Tap the line to place a mark.' },\n  ];\n  const FINISH = 'The bottom number names the piece. The top number counts the pieces.';\n  // The square: a top half in one piece, and a bottom half cut into two equal quarters.\n  const SQUARE = [0.5, 0.25, 0.25];\n  // Drawing sizes, in viewBox units (340 wide): a line from 0 at x = 20 to its end at x = 320.\n  const L0 = 20, LW = 300;\n  const tickX = (wholes, k) => L0 + (k / (4 * wholes)) * LW;     // the k-th quarter tick on a 0..wholes line\n\n  // ---------- answers (pure, so the checks can test them) ----------\n  const count = (on) => on.filter(Boolean).length;\n  const area = (on) => on.reduce((s, v, i) => s + (v ? SQUARE[i] : 0), 0);\n  function blank(i) {\n    const d = STEPS[i];\n    const n = d.kind === 'bar' ? d.bars * d.per : d.kind === 'square' ? 3 : 0;\n    return { on: new Array(n).fill(false), mark: null, pick: null, res: null, why: false, shown: false };\n  }\n  function isEmpty(i, st) {\n    const d = STEPS[i];\n    if (d.kind === 'bar' || d.kind === 'square') return count(st.on) === 0;\n    if (d.kind === 'line') return st.mark == null;\n    return st.pick == null;\n  }\n  function isRight(i, st) {\n    const d = STEPS[i];\n    if (d.kind === 'bar') return count(st.on) === d.want;\n    if (d.kind === 'square') return K.near(area(st.on), 0.5, 1e-9);\n    if (d.kind === 'line') return st.mark === d.want;\n    return st.pick === 'b';     // 3/4\n  }\n\n  let S = STEPS.map((d, i) => blank(i));\n  let finished = false;\n\n  // ---------- text with stacked fractions (built with K.el, never innerHTML) ----------\n  function frac(t, b) {\n    return K.el('span', { class: 'fr', role: 'img', 'aria-label': t + '/' + b },\n      K.el('span', { class: 'n', 'aria-hidden': 'true' }, t), K.el('span', { class: 'd', 'aria-hidden': 'true' }, b));\n  }\n  function write(el, text) {\n    el.textContent = '';\n    const re = /(\\d+)\\/(\\d+)/g;\n    let at = 0, m;\n    while ((m = re.exec(text))) {\n      if (m.index > at) el.appendChild(document.createTextNode(text.slice(at, m.index)));\n      el.appendChild(frac(m[1], m[2]));\n      at = m.index + m[0].length;\n    }\n    if (at < text.length) el.appendChild(document.createTextNode(text.slice(at)));\n  }\n  // A stacked fraction drawn in the SVG, centred on x, its bar at y.\n  function svgFrac(g, x, y, t, b, cls, barCls) {\n    g.appendChild(K.svg('text', { class: cls, x: x, y: y - 5, 'text-anchor': 'middle' }, String(t)));\n    g.appendChild(K.svg('line', { class: barCls, x1: x - 9, y1: y, x2: x + 9, y2: y }));\n    g.appendChild(K.svg('text', { class: cls, x: x, y: y + 16, 'text-anchor': 'middle' }, String(b)));\n  }\n\n  // ---------- controls ----------\n  const stepper = K.stepper({ id: 'step', label: 'Puzzle', steps: STEPS.map((d) => d.name), value: 0, compact: true, into: '#prog' });\n  const acts = document.getElementById('acts'), nav = document.getElementById('nav'), picks = document.getElementById('picks');\n  const at = () => stepper.get();\n  const changed = () => { S[at()].res = null; };\n\n  const whyBtn = K.button({ label: 'Why?', secondary: true, into: '#acts', press: () => { const st = S[at()]; st.why = !st.why; } });\n  const checkBtn = K.button({ label: 'Check', into: '#acts', press: () => {\n    const i = at(), st = S[i];\n    if (isEmpty(i, st)) { st.res = 'empty'; return; }\n    st.res = isRight(i, st) ? 'right' : 'wrong';\n    if (STEPS[i].kind === 'compare') st.shown = true;      // the bars appear once he has answered\n  } });\n  acts.insertBefore(checkBtn.el, whyBtn.el);\n  const pickA = K.button({ label: '5/8', secondary: true, into: '#picks', press: () => { if (S[3].res !== 'right') { S[3].pick = 'a'; changed(); } } });\n  const pickB = K.button({ label: '3/4', secondary: true, into: '#picks', press: () => { if (S[3].res !== 'right') { S[3].pick = 'b'; changed(); } } });\n  [[pickA, '5', '8'], [pickB, '3', '4']].forEach(([b, t, d]) => { b.el.textContent = ''; b.el.appendChild(frac(t, d)); });\n  const backBtn = K.button({ label: 'Back', secondary: true, into: '#nav', press: () => {\n    if (finished) { finished = false; return; }\n    stepper.set(Math.max(0, at() - 1), true);\n  } });\n  const nextBtn = K.button({ label: 'Continue', into: '#nav', press: () => {\n    if (at() < STEPS.length - 1) stepper.set(at() + 1, true);\n    else finished = true;\n  } });\n  const againBtn = K.button({ label: 'Start again', secondary: true, into: '#again', press: () => {\n    S = STEPS.map((d, i) => blank(i)); finished = false; stepper.set(0, true);\n  } });\n\n  // ---------- drawing ----------\n  const svg = document.getElementById('scene');\n  function piece(attrs, i, st, locked) {\n    const r = K.svg('rect', Object.assign({ class: 'pc' + (st.on[i] ? ' on' : '') + (locked ? ' locked' : ''), tabindex: locked ? -1 : 0, role: 'button',\n      'aria-pressed': st.on[i] ? 'true' : 'false', 'aria-label': 'Piece ' + (i + 1) }, attrs));\n    if (!locked) {\n      const flip = () => { st.on[i] = !st.on[i]; changed(); K.reveal(); K.refresh(); };\n      r.addEventListener('click', flip);\n      r.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });\n    }\n    return r;\n  }\n  function drawBars(d, st, locked) {\n    const H = 56, GAP = 18, W = LW / d.per;\n    svg.setAttribute('viewBox', '0 0 340 ' + (d.bars * H + (d.bars - 1) * GAP + 8));\n    for (let b = 0; b < d.bars; b++) {\n      const y = 4 + b * (H + GAP);\n      for (let k = 0; k < d.per; k++) svg.appendChild(piece({ x: L0 + k * W, y: y, width: W, height: H }, b * d.per + k, st, locked));\n      svg.appendChild(K.svg('rect', { class: 'edge', x: L0, y: y, width: LW, height: H }));\n    }\n    const n = count(st.on), total = d.bars * d.per;\n    return (d.bars === 1 ? 'A bar' : 'Two bars, one above the other, each') + ' cut into ' + d.per + ' equal pieces. ' + n + ' of the ' + total + ' pieces are coloured.';\n  }\n  function drawSquare(st, locked) {\n    svg.setAttribute('viewBox', '0 0 340 216');\n    const x = 70, y = 6, s = 204;\n    svg.appendChild(piece({ x: x, y: y, width: s, height: s / 2 }, 0, st, locked));\n    svg.appendChild(piece({ x: x, y: y + s / 2, width: s / 2, height: s / 2 }, 1, st, locked));\n    svg.appendChild(piece({ x: x + s / 2, y: y + s / 2, width: s / 2, height: s / 2 }, 2, st, locked));\n    svg.appendChild(K.svg('rect', { class: 'edge', x: x, y: y, width: s, height: s }));\n    return 'A square cut into one wide top piece and two small bottom pieces. ' + count(st.on) + ' of the 3 pieces are coloured.';\n  }\n  function drawLine(d, st, locked, right) {\n    svg.setAttribute('viewBox', '0 0 340 124');\n    const Y = 76, n = 4 * d.wholes, step = LW / n;\n    // Hops from 0 to the mark, once it is right: one arc per quarter-step.\n    if (right) {\n      for (let k = 0; k < st.mark; k++) {\n        const a = tickX(d.wholes, k), b = tickX(d.wholes, k + 1);\n        svg.appendChild(K.svg('path', { class: 'hop', d: 'M' + (a + 2) + ' ' + (Y - 4) + ' Q' + ((a + b) / 2) + ' ' + (Y - 26) + ' ' + (b - 2) + ' ' + (Y - 4) }));\n      }\n    }\n    svg.appendChild(K.svg('line', { class: 'axis', x1: L0, y1: Y, x2: L0 + LW, y2: Y }));\n    for (let k = 0; k <= n; k++) {\n      const x = tickX(d.wholes, k), whole = k % 4 === 0;\n      svg.appendChild(K.svg('line', { class: 'tick', x1: x, y1: whole ? Y - 12 : Y - 8, x2: x, y2: whole ? Y + 12 : Y + 8 }));\n      if (whole) svg.appendChild(K.svg('text', { class: 'num', x: x, y: Y + 34, 'text-anchor': 'middle' }, String(k / 4)));\n    }\n    if (st.mark != null) {\n      const x = tickX(d.wholes, st.mark);\n      svg.appendChild(K.svg('circle', { class: 'dot', cx: x, cy: Y, r: 9 }));\n      if (right) svgFrac(svg, Math.max(16, Math.min(324, x)), 26, d.want, 4, 'mlab', 'mbar');\n    }\n    // Tap targets: a tall strip around every tick (the nearest tick takes the tap).\n    for (let k = 0; k <= n; k++) {\n      const x = tickX(d.wholes, k);\n      const r = K.svg('rect', { class: 'hit' + (locked ? ' locked' : ''), x: x - step / 2, y: Y - 44, width: step, height: 88, tabindex: locked ? -1 : 0, role: 'button',\n        'aria-label': 'Tick ' + k + ' of ' + n });\n      if (!locked) {\n        const put = () => { st.mark = k; changed(); K.reveal(); K.refresh(); };\n        r.addEventListener('click', put);\n        r.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); put(); } });\n      }\n      svg.appendChild(r);\n    }\n    return 'A number line from 0 to ' + d.wholes + ' with a tick at every quarter. ' +\n      (st.mark == null ? 'No mark yet.' : 'The mark is on tick ' + st.mark + ' of ' + n + '.');\n  }\n  function drawCompare(st) {\n    svg.setAttribute('viewBox', '0 0 340 132');\n    const X = 56, W = 264, H = 46, rows = [{ t: 5, b: 8, y: 6 }, { t: 3, b: 4, y: 78 }];\n    rows.forEach((r) => {\n      svgFrac(svg, 26, r.y + H / 2 + 2, r.t, r.b, 'lab', 'fbar');\n      svg.appendChild(K.svg('rect', { class: 'blank', x: X, y: r.y, width: W, height: H }));\n      if (!st.shown) return;\n      const w = W / r.b;\n      for (let k = 0; k < r.b; k++) svg.appendChild(K.svg('rect', { class: 'pc locked' + (k < r.t ? ' on' : ''), x: X + k * w, y: r.y, width: w, height: H }));\n      svg.appendChild(K.svg('rect', { class: 'edge', x: X, y: r.y, width: W, height: H }));\n    });\n    return st.shown ? 'Two bars of the same length. The top one is cut into 8 pieces with 5 coloured; the bottom one into 4 pieces with 3 coloured.'\n      : 'Two empty bars of the same length, one for 5/8 and one for 3/4.';\n  }\n\n  const el = (id) => document.getElementById(id);\n  el('finish').textContent = FINISH;\n  K.update((p) => {\n    const i = Math.round(p.step), d = STEPS[i], st = S[i];\n    const right = st.res === 'right';\n    el('count').textContent = 'Puzzle ' + (i + 1) + ' of ' + STEPS.length;\n    write(el('task'), d.task);\n    svg.textContent = '';\n    let aria;\n    if (d.kind === 'bar') aria = drawBars(d, st, right);\n    else if (d.kind === 'square') aria = drawSquare(st, right);\n    else if (d.kind === 'line') aria = drawLine(d, st, right, right);\n    else aria = drawCompare(st);\n    svg.setAttribute('aria-label', aria);\n\n    picks.hidden = d.kind !== 'compare';\n    pickA.el.setAttribute('aria-pressed', st.pick === 'a' ? 'true' : 'false');\n    pickB.el.setAttribute('aria-pressed', st.pick === 'b' ? 'true' : 'false');\n\n    checkBtn.el.hidden = right;\n    const fb = el('fb');\n    fb.className = 'fb' + (right ? ' right' : st.res === 'wrong' ? ' wrong' : '');\n    fb.textContent = right ? 'That\\'s it.' : st.res === 'wrong' ? d.hint : st.res === 'empty' ? d.empty : '';\n\n    const why = el('why');\n    why.hidden = !st.why;\n    write(why, d.why);\n    whyBtn.setLabel(st.why ? 'Hide why' : 'Why?');\n\n    backBtn.el.hidden = i === 0 && !finished;\n    nextBtn.el.hidden = !right || finished;\n    nextBtn.setLabel(i === STEPS.length - 1 ? 'Finish' : 'Continue');\n    nav.hidden = backBtn.el.hidden && nextBtn.el.hidden;\n\n    const done = el('done');\n    done.hidden = !finished;\n  });\n\n  // ---------- known answers, worked out by hand ----------\n  K.check('Puzzle 1: any three of the four pieces is 3/4 of the bar; none, two or all four is not', () => {\n    for (let m = 0; m < 16; m++) {\n      const st = blank(0);\n      st.on = [0, 1, 2, 3].map((k) => !!(m & (1 << k)));\n      if (isRight(0, st) !== (count(st.on) === 3)) return false;\n    }\n    return true;\n  });\n  K.check('Puzzle 2: the wide piece alone is half the square, and so are the two small ones together; one small piece, or the wide one with a small one, is not', () => {\n    const t = (on) => isRight(1, Object.assign(blank(1), { on: on }));\n    return K.near(SQUARE[0] + SQUARE[1] + SQUARE[2], 1, 1e-12) && t([true, false, false]) && t([false, true, true]) &&\n      !t([false, true, false]) && !t([false, false, true]) && !t([true, true, false]) && !t([true, true, true]);\n  });\n  K.check('Puzzles 3 and 6: 3/4 is the third quarter tick, three quarters of the way from 0 to 1; 7/4 is the seventh, three ticks past 1', () => {\n    const one = (tickX(1, 4) - L0), two = (tickX(2, 8) - L0) / 2;\n    return K.near((tickX(1, 3) - L0) / one, 0.75, 1e-9) && K.near((tickX(2, 7) - L0) / two, 1.75, 1e-9) &&\n      K.near(tickX(2, 7) - tickX(2, 4), 3 * (tickX(2, 1) - tickX(2, 0)), 1e-9) &&\n      isRight(2, Object.assign(blank(2), { mark: 3 })) && !isRight(2, Object.assign(blank(2), { mark: 4 })) &&\n      isRight(5, Object.assign(blank(5), { mark: 7 })) && !isRight(5, Object.assign(blank(5)