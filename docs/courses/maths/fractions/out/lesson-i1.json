 "interactive": {
  "html": "<!-- kind: quantity -->\n<style>\n  .bars .whole { fill: var(--k-panel); }\n  .bars .run { fill: var(--k-accent2); transition: width .2s ease; }\n  .bars .cut { stroke: var(--k-strong); stroke-width: 1.5; }\n  .bars .cut.in { stroke: var(--k-bg); stroke-width: 2; }\n  .bars .split { stroke: var(--k-strong); stroke-width: 3.5; }\n  .bars .edge { fill: none; stroke: var(--k-strong); stroke-width: 2; }\n  .bars .keyt { font: 13px var(--k-font); fill: var(--k-ink); }\n  .bars .keysw { fill: var(--k-accent2); }\n  .bars .keysw.empty { fill: var(--k-panel); stroke: var(--k-strong); stroke-width: 1.5; }\n  .bars .wlab { font: 600 13px var(--k-font); fill: var(--k-accent); }\n  .bars .wlab.full { fill: var(--k-accent2); }\n  .bars .axis { stroke: var(--k-ink); stroke-width: 2; }\n  .bars .tick { stroke: var(--k-ink); stroke-width: 1.5; }\n  .bars .tick.big { stroke-width: 2; }\n  .bars .num { font: 700 15px var(--k-font); fill: var(--k-ink); }\n  .bars .guide { stroke: var(--k-accent2); stroke-width: 2; }\n  .bars .dot { fill: var(--k-accent2); stroke: var(--k-bg); stroke-width: 2; }\n  .bars .nm { font: 800 17px var(--k-font); fill: var(--k-accent2); }\n  .bars .fr { font: 700 14px var(--k-font); fill: var(--k-accent2); }\n  .bars .fbar { stroke: var(--k-accent2); stroke-width: 1.5; }\n  .bars .hit { fill: var(--k-bg); fill-opacity: 0; }\n  .bars .tap { fill: var(--k-bg); fill-opacity: 0; cursor: pointer; }\n</style>\n\n<p class=\"lead\">Two bars, each one whole cut into 4 equal pieces, over a line from 0 to 2: the counted pieces shade in as one run, and the mark on the line sits under the run's end.</p>\n\n<svg class=\"bars\" id=\"scene\" viewBox=\"0 0 340 172\" width=\"100%\" role=\"img\" aria-label=\"\">\n  <g id=\"key\">\n    <rect class=\"keysw\" x=\"20\" y=\"3\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <text class=\"keyt\" x=\"36\" y=\"13\">counted, 1/4 of a bar each</text>\n    <rect class=\"keysw empty\" x=\"208\" y=\"3\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <text class=\"keyt\" x=\"224\" y=\"13\">not counted</text>\n  </g>\n  <text class=\"wlab\" id=\"wlab0\" x=\"95\" y=\"33\" text-anchor=\"middle\"></text>\n  <text class=\"wlab\" id=\"wlab1\" x=\"245\" y=\"33\" text-anchor=\"middle\"></text>\n  <rect class=\"whole\" x=\"20\" y=\"38\" width=\"300\" height=\"44\"/>\n  <rect class=\"run\" id=\"run\" x=\"20\" y=\"38\" width=\"0\" height=\"44\"/>\n  <g id=\"cuts\"></g>\n  <line class=\"split\" x1=\"170\" y1=\"38\" x2=\"170\" y2=\"82\"/>\n  <rect class=\"edge\" x=\"20\" y=\"38\" width=\"150\" height=\"44\"/>\n  <rect class=\"edge\" x=\"170\" y=\"38\" width=\"150\" height=\"44\"/>\n  <g id=\"taps\"></g>\n  <line class=\"axis\" x1=\"12\" y1=\"104\" x2=\"328\" y2=\"104\"/>\n  <g id=\"ticks\"></g>\n  <g id=\"mark\">\n    <rect class=\"hit\" x=\"-24\" y=\"86\" width=\"48\" height=\"86\"/>\n    <line class=\"guide\" x1=\"0\" y1=\"82\" x2=\"0\" y2=\"104\"/>\n    <circle class=\"dot\" cx=\"0\" cy=\"104\" r=\"6\"/>\n    <g id=\"name\"></g>\n  </g>\n</svg>\n<div class=\"k-controls\" id=\"controls\"></div>\n<p class=\"say\" id=\"say\"></p>\n<div class=\"k-readouts\" id=\"outs\"></div>\n<p class=\"caption\">Bottom names the piece, top counts the pieces from zero; where the count ends is the number.</p>\n\n<script>\n  // Four quarters make one whole: that is what \"quarter\" means, and what the 4 under the line says.\n  const PER_BAR = 4;\n  const SOURCE = 'https://thecorestandards.org/Math/Content/NF';   // [5]: the interval's endpoint locates a/b\n  // The drawing: the 0 end at x = 20, one bar = 150 units, so one quarter piece = 37.5 units.\n  const X0 = 20, BAR = 150, Q = BAR / PER_BAR;\n  const xAt = (n) => X0 + n * Q;              // the right edge of the n-th counted piece\n  const lineX = (v) => X0 + v * BAR;          // where the number v sits on the line\n  const plural = (n, w) => n + ' ' + w + (n === 1 ? '' : 's');\n\n  const quarters = K.control({\n    id: 'quarters', label: 'Quarters counted from zero', hint: 'Or drag the mark, or tap a piece to count up to it',\n    min: 0, max: 8, step: 1, value: 3, fmt: (v) => plural(v, 'quarter'), into: '#controls',\n  });\n  K.stage('#scene', '#controls');\n  // Dan can move the mark itself along the line: the slider follows it.\n  K.drag('#mark', { control: 'quarters', toValue: (x) => Math.round((x - X0) / Q) });\n\n  K.readout({ id: 'position', label: 'Place on the line', decimals: 2, big: true, into: '#outs' });\n  K.readout({ id: 'wholeBars', label: 'Whole bars filled', decimals: 0, into: '#outs' });\n  K.readout({ id: 'quartersPast', label: 'Quarters past the whole bars', decimals: 0, fmt: (v) => plural(v, 'quarter'), into: '#outs' });\n\n  // The rule is plain counting: place = count ÷ 4; whole bars = complete fours; quarters past = what is left.\n  K.model((p) => {\n    const n = Math.round(p.quarters);\n    const whole = Math.floor(n / PER_BAR);\n    return { position: n / PER_BAR, wholeBars: whole, quartersPast: n - PER_BAR * whole };\n  });\n\n  // Drawn once: the cuts in the bars, a tap target on every piece, and the line's ticks (0, 1, 2 under the bar ends).\n  const cuts = document.getElementById('cuts'), cutEls = [];\n  for (let i = 1; i < 2 * PER_BAR; i++) {\n    if (i === PER_BAR) continue;   // the boundary between the bars is drawn heavier, in the markup\n    cutEls[i] = cuts.appendChild(K.svg('line', { class: 'cut', x1: xAt(i), y1: 38, x2: xAt(i), y2: 82 }));\n  }\n  const taps = document.getElementById('taps');\n  for (let i = 0; i < 2 * PER_BAR; i++) {\n    taps.appendChild(K.svg('rect', { class: 'tap', x: xAt(i), y: 38, width: Q, height: 44, on: { click: () => { quarters.set(i + 1); K.reveal(); } } }));\n  }\n  const ticks = document.getElementById('ticks');\n  for (let i = 0; i <= 2 * PER_BAR; i++) {\n    const x = xAt(i), big = i % PER_BAR === 0;\n    ticks.appendChild(K.svg('line', { class: 'tick' + (big ? ' big' : ''), x1: x, y1: big ? 96 : 99, x2: x, y2: big ? 112 : 109 }));\n    if (big) ticks.appendChild(K.svg('text', { class: 'num', x: x, y: 128, 'text-anchor': 'middle' }, String(i / PER_BAR)));\n  }\n\n  // The place's name as plain text (for the checks): a fraction; a whole number where the count lands on one; past 1 a mixed number too.\n  function nameOf(n) {\n    const whole = Math.floor(n / PER_BAR), more = n - PER_BAR * whole;\n    if (more === 0) return n + '/' + PER_BAR + ' = ' + whole;\n    if (whole === 0) return n + '/' + PER_BAR;\n    return n + '/' + PER_BAR + ' = ' + whole + ' ' + more + '/' + PER_BAR;\n  }\n  // The same name typeset under the mark: each fraction stacked, top over bottom, so a mixed number's whole and fraction never run together.\n  const FW = 17, GAP = 5;\n  function stack(g, x, top, bottom) {\n    g.appendChild(K.svg('text', { class: 'fr', x: x + FW / 2, y: 146, 'text-anchor': 'middle' }, String(top)));\n    g.appendChild(K.svg('line', { class: 'fbar', x1: x + 1, y1: 150, x2: x + FW - 1, y2: 150 }));\n    g.appendChild(K.svg('text', { class: 'fr', x: x + FW / 2, y: 164, 'text-anchor': 'middle' }, String(bottom)));\n    return x + FW;\n  }\n  function typeset(n, mx) {\n    const g = document.getElementById('name');\n    g.textContent = '';\n    const whole = Math.floor(n / PER_BAR), more = n - PER_BAR * whole;\n    const eq = more === 0 || whole > 0;                 // \"= whole\" follows the fraction on a whole number, or past 1\n    const width = FW + (eq ? GAP + 24 : 0) + (eq && more > 0 ? GAP + FW : 0);\n    // Centred on the mark, but kept inside the drawing at either end.\n    let x = -width / 2;\n    x = Math.max(4 - mx, Math.min(336 - mx - width, x));\n    x = stack(g, x, n, PER_BAR);\n    if (eq) {\n      g.appendChild(K.svg('text', { class: 'nm', x: x + GAP, y: 157 }, '= ' + whole));\n      x += GAP + 24;\n      if (more > 0) stack(g, x + GAP, more, PER_BAR);\n    }\n  }\n\n  const svg = document.getElementById('scene');\n  function draw(p, o) {\n    const n = Math.round(p.quarters), mx = xAt(n), whole = o.wholeBars, more = o.quartersPast;\n    // The run of counted pieces from the left end; the cuts inside it show as slits.\n    document.getElementById('run').setAttribute('width', mx - X0);\n    cutEls.forEach((el, i) => { if (el) el.setAttribute('class', 'cut' + (i < n ? ' in' : '')); });\n    // Above each bar: what it is, and when its 4 pieces are all counted, what that makes.\n    [0, 1].forEach((k) => {\n      const full = whole > k, el = document.getElementById('wlab' + k);\n      el.textContent = full ? '4 quarters = 1 whole' : 'one whole';\n      el.setAttribute('class', 'wlab' + (full ? ' full' : ''));\n    });\n    // The mark, on the line under where the run ends, with the place's name beneath it.\n    document.getElementById('mark').setAttribute('transform', 'translate(' + mx + ' 0)');\n    typeset(n, mx);\n\n    let where;\n    if (n === 0) where = 'rests on 0';\n    else if (n < PER_BAR) where = 'sits short of 1';\n    else if (n === PER_BAR) where = 'sits on 1';\n    else if (n < 2 * PER_BAR) where = 'sits past 1';\n    else where = 'sits on 2';\n    svg.setAttribute('aria-label', 'Two bars, each one whole cut into four equal pieces, over a number line from 0 to 2. ' +\n      plural(n, 'piece') + ' counted from the left end are shaded as one run, and the mark on the line ' + where + ', under the run\\'s end.');\n\n    const pos = K.fmt(o.position, { decimals: 2 });\n    let s;\n    if (n === 0) {\n      s = 'No quarters are counted, so no piece is shaded and the mark rests on 0: 0/4 is the same place as 0.';\n    } else if (n < PER_BAR) {\n      s = plural(n, 'quarter') + ' counted from the left end shade' + (n === 1 ? 's' : '') + ' ' + n + ' of the first bar\\'s 4 pieces, so the mark sits at ' +\n        pos + ', short of 1: ' + n + '/4 is one number with one place on the line.';\n    } else if (n === PER_BAR) {\n      s = '4 quarters counted from the left end fill the first bar with none left over, so the mark lands on 1: 4/4 is the same place as the whole number 1.';\n    } else if (n < 2 * PER_BAR) {\n      s = n + ' quarters counted from the left end: 4 fill the first bar and ' + more + ' more shade' + (more === 1 ? 's' : '') + ' the second, so the mark sits at ' +\n        pos + ', past 1: ' + n + '/4 is one place, and as a mixed number it is 1 whole and ' + more + '/4.';\n    } else {\n      s = '8 quarters counted from the left end fill both bars, so the mark lands on 2: 8/4 is the same place as the whole number 2.';\n    }\n    document.getElementById('say').textContent = s;\n  }\n  K.update(draw);\n\n  // Known answers, counted by hand.\n  K.check('3 quarters from zero: the mark at 0.75, no whole bar filled, 3 quarters past; of a bar called one metre (1000 mm) that run is 750 mm', () => {\n    const o = K.at({ quarters: 3 });\n    return K.near(o.position, 0.75, 1e-9) && o.wholeBars === 0 && o.quartersPast === 3 && K.near(o.position * 1000, 750, 1e-9) && nameOf(3) === '3/4';\n  });\n  K.check('4 quarters fill the first bar exactly: the mark on 1, 4/4 = 1, with no quarters past it', () => {\n    const o = K.at({ quarters: 4 });\n    return K.near(o.position, 1, 1e-9) && o.wholeBars === 1 && o.quartersPast === 0 && nameOf(4) === '4/4 = 1';\n  });\n  K.check('7 quarters fill one bar and 3 of the second: the mark at 1.75, 7/4 = 1 3/4', () => {\n    const o = K.at({ quarters: 7 });\n    return K.near(o.position, 1.75, 1e-9) && o.wholeBars === 1 && o.quartersPast === 3 && nameOf(7) === '7/4 = 1 3/4';\n  });\n  K.check('Each quarter added moves the mark the same 0.25 step, from 0 at no quarters to 2 at 8, and a drag to a cut counts the pieces up to it', () => {\n    for (let n = 0; n < 2 * PER_BAR; n++) {\n      if (!K.near(K.at({ quarters: n + 1 }).position - K.at({ quarters: n }).position, 0.25, 1e-9)) return false;\n      if (Math.round((xAt(n) - X0) / Q) !== n) return false;\n    }\n    return K.near(K.at({ quarters: 0 }).position, 0, 1e-9) && K.near(K.at({ quarters: 8 }).position, 2, 1e-9) && nameOf(0) === '0/4 = 0' && nameOf(8) === '8/4 = 2';\n  });\n  K.check('The shaded run is as long as the fraction says, and its end point is where that number sits on the line', () => {\n    for (let n = 0; n <= 2 * PER_BAR; n++) {\n      const o = K.at({ quarters: n });\n      if (!K.near((xAt(n) - X0) / BAR, o.position, 1e-9)) return false;   // the run's length, in bars, is the number n/4\n      if (!K.near(xAt(n), lineX(o.position), 1e-9)) return false;          // and the mark stands on the line at that number\n    }\n    return true;\n  }, { source: SOURCE });\n\n  K.ready();\n</script>",
