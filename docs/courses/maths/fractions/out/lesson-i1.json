 "interactive": {
  "html": "<!-- kind: concept -->\n<style>\n  [hidden] { display: none !important; }\n  .pz { max-width: 30rem; }\n  .pz > * + *, #stepbox > * + * { margin-top: 14px; }\n  /* The stepper is the page's step control: its dots are the progress bar; Back and Continue are below. */\n  .pz .k-stepper { gap: 0; }\n  .pz .k-stepper .k-label, .pz .k-stepper-nav { display: none; }\n  .pz .count { margin-top: 10px; }\n  .task { font-size: 1.2rem; font-weight: 700; line-height: 1.5; margin-top: 4px; }\n  .task.show { font-size: 1.12rem; font-weight: 400; line-height: 1.6; }\n  .fr { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; line-height: 1.1; font-weight: 700; margin: 0 .1em; font-size: .9em; }\n  .fr .n { border-bottom: 2px solid currentColor; padding: 0 .18em; }\n  .fr .d { padding: 0 .18em; }\n  .scene { display: block; width: 100%; }\n  .scene .pc { fill: var(--k-panel); stroke: var(--k-strong); stroke-width: 2; cursor: pointer; transition: fill .15s ease; }\n  .scene .pc.on { fill: var(--k-accent2); }\n  .scene .pc.locked { cursor: default; }\n  .scene .pc:focus { outline: none; }\n  .scene .pc:focus-visible, .scene .hit:focus-visible { stroke: var(--k-accent); stroke-width: 4; }\n  .scene .edge { fill: none; stroke: var(--k-strong); stroke-width: 2.5; }\n  .scene .blank { fill: var(--k-panel); stroke: var(--k-strong); stroke-width: 2.5; }\n  .scene .cut { stroke: var(--k-strong); stroke-width: 2; }\n  .scene .axis { stroke: var(--k-ink); stroke-width: 2.5; stroke-linecap: round; }\n  .scene .tick { stroke: var(--k-ink); stroke-width: 2; }\n  .scene .num { font: 700 16px var(--k-font); fill: var(--k-ink); }\n  .scene .lab { font: 700 15px var(--k-font); fill: var(--k-ink); }\n  .scene .big { font: 700 22px var(--k-font); fill: var(--k-ink); }\n  .scene .fbar { stroke: var(--k-ink); stroke-width: 1.5; }\n  .scene .bbar { stroke: var(--k-ink); stroke-width: 2; }\n  .scene .onnum { font: 700 16px var(--k-font); fill: var(--k-on-accent2); }\n  .scene .onbar { stroke: var(--k-on-accent2); stroke-width: 1.5; }\n  .scene .tl { font: 700 15px var(--k-font); fill: var(--k-accent); }\n  .scene .drop { stroke: var(--k-accent2); stroke-width: 2; stroke-dasharray: 5 4; }\n  .scene .hit { fill: var(--k-bg); fill-opacity: 0; cursor: pointer; }\n  .scene .hit.locked { cursor: default; }\n  .scene .dot { fill: var(--k-accent2); stroke: var(--k-bg); stroke-width: 2.5; }\n  .scene .hop { fill: none; stroke: var(--k-accent); stroke-width: 2; }\n  .scene .mlab { font: 700 15px var(--k-font); fill: var(--k-accent2); }\n  .scene .mbar { stroke: var(--k-accent2); stroke-width: 1.5; }\n  .row { display: flex; flex-wrap: wrap; gap: 10px; }\n  .row .k-btn { flex: 1 1 7rem; }\n  .replay { display: flex; justify-content: flex-end; }\n  .replay .k-btn { flex: 0 0 auto; min-height: 44px; padding-left: 16px; padding-right: 16px; font-size: .95rem; }\n  .picks .k-btn { font-size: 1.15rem; min-height: 56px; }\n  .picks .k-btn[aria-pressed=\"true\"] { background: var(--k-accent2); color: var(--k-on-accent2); border-color: var(--k-accent2); }\n  .fb { font-weight: 700; min-height: 1.5em; margin-top: 10px; }\n  .fb.right { color: var(--k-good); }\n  .fb.wrong { color: var(--k-ink); }\n  .why { line-height: 1.6; }\n  .done { line-height: 1.6; }\n  .done strong { color: var(--k-accent2); }\n  .done .row { margin-top: 14px; }\n  /* Each new screen fades in softly, rising 4 px into place (restarted by enter() below). Off for\n     reduced motion, and while the self-test looks, as the kit's own fade-ins are. */\n  .enter { animation: soft-in .35s ease-out backwards; }\n  @keyframes soft-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }\n  html.k-testing .enter { animation: none; }\n  @media (prefers-reduced-motion: reduce) { .scene .pc { transition: none; } .enter { animation: none; } }\n</style>\n\n<p class=\"lead\">A bar, a square and a number line, one small step at a time.</p>\n\n<div class=\"pz\" id=\"pz\">\n  <div id=\"prog\"></div>\n  <div id=\"stepbox\">\n    <p class=\"k-label count\" id=\"count\"></p>\n    <p class=\"task\" id=\"task\"></p>\n    <svg class=\"scene\" id=\"scene\" viewBox=\"0 0 340 80\" width=\"100%\" role=\"img\" aria-label=\"\"></svg>\n    <div class=\"replay\" id=\"replay\"></div>\n    <div class=\"row picks\" id=\"picks\"></div>\n    <div class=\"row acts\" id=\"acts\"></div>\n    <p class=\"fb\" id=\"fb\" aria-live=\"polite\"></p>\n    <div class=\"note why\" id=\"why\" hidden></div>\n  </div>\n  <div class=\"panel done\" id=\"done\" hidden>\n    <p><strong id=\"finish\"></strong></p>\n    <div class=\"row\" id=\"again\"></div>\n  </div>\n  <div class=\"row nav\" id=\"nav\"></div>\n</div>\n\n<p class=\"caption\">Every bar and square here is one whole.</p>\n\n<script>\n  // ---------- the lesson: SHOW steps demonstrate, DO steps are puzzles ----------\n  const EMPTY_PIECE = 'Tap a piece to colour it.', EMPTY_LINE = 'Tap the line to place a mark.';\n  const STEPS = [\n    { show: true, demo: 'cut', dur: 3.0, name: 'One whole, four quarters',\n      text: 'This bar is one *whole*. Cut it into 4 equal pieces and each piece is a *quarter*.' },\n    { kind: 'bar', bars: 1, per: 4, want: 1, name: 'Colour one quarter',\n      task: 'Colour 1/4 of the bar.',\n      why: 'The 4 cuts the bar into four equal pieces. The 1 says to colour one of them.',\n      hint: 'Not quite. A quarter is just one of the pieces.', empty: EMPTY_PIECE },\n    { show: true, demo: 'count', dur: 4.0, name: 'Three quarters',\n      text: '3/4 means three of those quarters. The bottom number *names the piece*. The top number *counts* them.' },\n    { kind: 'bar', bars: 1, per: 4, want: 3, name: 'Colour three quarters',\n      task: 'Colour 3/4 of the bar.',\n      why: 'The bottom number, 4, cuts the bar into four equal pieces. The top number, 3, says to colour three of them.',\n      hint: 'Not quite. Count the shaded pieces.', empty: EMPTY_PIECE },\n    { show: true, demo: 'square', dur: 3.1, name: 'Equal pieces',\n      text: '*Half* means half the space, not half the pieces. This square has one big piece and two small ones. The big piece takes up half the square on its own.' },\n    { kind: 'square', name: 'Colour half the square',\n      task: 'Colour 1/2 of this square.',\n      why: 'Half means half the space, not half the pieces. The left piece is half on its own, and so are the two small ones together.',\n      hint: 'Not quite. Compare the space, not the number of pieces.', empty: EMPTY_PIECE },\n    { show: true, demo: 'drop', dur: 4.1, name: 'A place on the line',\n      text: 'A fraction is also a place on a *number line*. Shade 3/4 of the bar and drop straight down. The mark lands at 3/4.' },\n    { kind: 'line', wholes: 1, want: 3, name: 'Find 3/4 on the line',\n      task: 'Tap where 3/4 goes on the line.',\n      why: 'Count three quarter-steps from 0. Where you stop is the number 3/4.',\n      hint: 'Not quite. Count the quarter-steps from 0.', empty: EMPTY_LINE },\n    { kind: 'compare', name: 'Which is bigger?',\n      task: 'Which is bigger, 5/8 or 3/4?',\n      why: 'Bigger numbers don\\'t make a bigger fraction. Five eighths is a little less than three quarters.',\n      hint: 'Not quite. Compare the space each one fills.', empty: 'Tap one of the two answers.' },\n    { show: true, demo: 'carry', dur: 4.5, name: 'Past one',\n      text: 'Keep counting past four quarters and you go past 1. Seven quarters fill one bar and three of the next. That is 7/4, also written 1 3/4.' },\n    { kind: 'bar', bars: 2, per: 4, want: 7, name: 'Colour seven quarters',\n      task: 'Colour 7/4.',\n      why: 'Four quarters fill one whole bar. Three more go into the next, so 7/4 is one whole and three quarters, written 1 3/4.',\n      hint: 'Not quite. Count the shaded pieces.', empty: EMPTY_PIECE },\n    { kind: 'line', wholes: 2, want: 7, name: 'Find 7/4 on the line',\n      task: 'Tap where 7/4 goes on the line.',\n      why: 'Seven quarter-steps from 0 takes you past 1 and three steps more.',\n      hint: 'Not quite. Count the quarter-steps from 0.', empty: EMPTY_LINE },\n  ];\n  const FINISH = 'The bottom number names the piece. The top number counts the pieces.';\n  // When each demonstration's parts arrive, in seconds after the screen opens. Each part takes\n  // K.SOFT (0.6 s) to arrive, fading in; the first comes once the screen itself has faded in.\n  const AT = {\n    cut: [0.5, 1.1, 1.7], cutLabels: 2.4,                        // three cuts grow down the bar, then a quarter label in each piece\n    count: [0.5, 1.1, 1.7], countRule: [2.3, 2.9, 3.4],          // three quarters shade, then the stacked 3/4, what its top does, what its bottom does\n    square: 0.5, squareHalf: 1.2, squareSmall: [1.9, 2.5],       // the big piece shades and is named, then each small piece is named\n    drop: [0.5, 1.1, 1.7], dropFrom: 2.3, dropTo: 3.0,           // three quarters shade, then a line eases down to the number line,\n    dropDot: 2.9, dropLabel: 3.5,                                //   where the mark arrives, then its 3/4\n    carry: [0.5, 1.0, 1.5, 2.0, 2.6, 3.1, 3.6], carryWhole: 2.2, carryDone: 3.9,\n  };\n  const FADE_IN = 0.35, GROW = 0.6;   // the screen's own fade-in; how long a cut takes to grow down the bar\n  // After a right answer the picture's new parts arrive too: on a line the hops, one after\n  // another from 0, then the label; on the compare screen the two bars' pieces, row by row.\n  const HOP = { from: 0.15, gap: 0.22 }, ROWS = [0.15, 0.65];\n  // The squares: one big half, and the other half cut into two equal quarters.\n  const SQUARE = [0.5, 0.25, 0.25];\n  // Drawing sizes, in viewBox units (340 wide): bars and lines run from x = 20 to x = 320.\n  const L0 = 20, LW = 300;\n  const tickX = (wholes, k) => L0 + (k / (4 * wholes)) * LW;     // the k-th quarter tick on a 0..wholes line\n  const REDUCE = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);\n\n  // ---------- answers (pure, so the checks can test them) ----------\n  const count = (on) => on.filter(Boolean).length;\n  const area = (on) => on.reduce((s, v, i) => s + (v ? SQUARE[i] : 0), 0);\n  function blank(i) {\n    const d = STEPS[i];\n    const n = d.kind === 'bar' ? d.bars * d.per : d.kind === 'square' ? 3 : 0;\n    return { on: new Array(n).fill(false), mark: null, pick: null, res: null, why: false, shown: false };\n  }\n  function isEmpty(i, st) {\n    const d = STEPS[i];\n    if (d.kind === 'bar' || d.kind === 'square') return count(st.on) === 0;\n    if (d.kind === 'line') return st.mark == null;\n    return st.pick == null;\n  }\n  function isRight(i, st) {\n    const d = STEPS[i];\n    if (d.kind === 'bar') return count(st.on) === d.want;\n    if (d.kind === 'square') return K.near(area(st.on), 0.5, 1e-9);\n    if (d.kind === 'line') return st.mark === d.want;\n    return st.pick === 'b';     // 3/4\n  }\n  const CMP = STEPS.findIndex((d) => d.kind === 'compare');\n\n  let S = STEPS.map((d, i) => blank(i));\n  let finished = false, lastStep = -1, wasDone = false, T = 0;   // T: seconds into the current demonstration (or answer's reveal)\n  // How far a part due at t0 has arrived at time T (0 before, easing up to 1; 1 when T is Infinity).\n  // While the self-test looks (html.k-testing) a part already on its way is shown arrived, as the\n  // kit's own fade-ins are, so it judges the finished part, not a frame of its fade.\n  let looking = false;\n  const arr = (t0, dur) => { const a = K.arrive(T, t0, dur); return looking && a > 0 ? 1 : a; };\n  // Fade parts in at arrival a: numbers, fractions and labels rise 6 units into place; shapes stay put (rise 0).\n  const fadeIn = (els, a, rise) => { [].concat(els).forEach((e) => K.fade(e, a, rise)); return els; };\n  // The end of an answer's reveal on DO step i (0 when nothing new arrives).\n  function revealEnd(i) {\n    const d = STEPS[i];\n    if (d.kind === 'line') return HOP.from + d.want * HOP.gap + K.SOFT;\n    if (d.kind === 'compare') return ROWS[ROWS.length - 1] + K.SOFT;\n    return 0;\n  }\n\n  // ---------- text with stacked fractions and amber key terms (built with K.el, never innerHTML) ----------\n  function frac(t, b) {\n    return K.el('span', { class: 'fr', role: 'img', 'aria-label': t + '/' + b },\n      K.el('span', { class: 'n', 'aria-hidden': 'true' }, t), K.el('span', { class: 'd', 'aria-hidden': 'true' }, b));\n  }\n  function write(el, text) {\n    el.textContent = '';\n    const re = /\\*([^*]+)\\*|(\\d+)\\/(\\d+)/g;\n    let at = 0, m;\n    while ((m = re.exec(text))) {\n      if (m.index > at) el.appendChild(document.createTextNode(text.slice(at, m.index)));\n      el.appendChild(m[1] ? K.el('span', { class: 'term' }, m[1]) : frac(m[2], m[3]));\n      at = m.index + m[0].length;\n    }\n    if (at < text.length) el.appendChild(document.createTextNode(text.slice(at)));\n  }\n  // A stacked fraction drawn in the SVG, centred on x, its bar at y.\n  function svgFrac(x, y, t, b, cls, barCls, half, gap) {\n    half = half || 9; gap = gap || 16;\n    return [\n      svg.appendChild(K.svg('text', { class: cls, x: x, y: y - 5, 'text-anchor': 'middle' }, String(t))),\n      svg.appendChild(K.svg('line', { class: barCls, x1: x - half, y1: y, x2: x + half, y2: y })),\n      svg.appendChild(K.svg('text', { class: cls, x: x, y: y + gap, 'text-anchor': 'middle' }, String(b))),\n    ];\n  }\n  const text = (x, y, s, cls, anchor) => svg.appendChild(K.svg('text', { class: cls, x: x, y: y, 'text-anchor': anchor || 'middle' }, String(s)));\n\n  // ---------- controls ----------\n  const stepper = K.stepper({ id: 'step', label: 'Step', steps: STEPS.map((d) => d.name), value: 0, compact: true, into: '#prog' });\n  const nav = document.getElementById('nav'), picks = document.getElementById('picks');\n  const at = () => stepper.get();\n  const changed = () => { S[at()].res = null; };\n\n  const checkBtn = K.button({ label: 'Check', into: '#acts', press: () => {\n    const i = at(), st = S[i];\n    if (STEPS[i].show || finished) return;\n    if (isEmpty(i, st)) { st.res = 'empty'; return; }\n    st.res = isRight(i, st) ? 'right' : 'wrong';\n    if (STEPS[i].kind === 'compare') {                       // the bars appear once he has answered\n      const fresh = !st.shown;\n      st.shown = true;\n      if (fresh) reveal();\n    } else if (STEPS[i].kind === 'line' && st.res === 'right') reveal();   // the hops count up to his mark\n  } });\n  const whyBtn = K.button({ label: 'Why?', secondary: true, into: '#acts', press: () => {\n    if (STEPS[at()].show || finished) return;\n    const st = S[at()]; st.why = !st.why;\n  } });\n  const pickA = K.button({ label: '5/8', secondary: true, into: '#picks', press: () => { if (S[CMP].res !== 'right') { S[CMP].pick = 'a'; S[CMP].res = null; } } });\n  const pickB = K.button({ label: '3/4', secondary: true, into: '#picks', press: () => { if (S[CMP].res !== 'right') { S[CMP].pick = 'b'; S[CMP].res = null; } } });\n  [[pickA, '5', '8'], [pickB, '3', '4']].forEach(([b, t, d]) => { b.el.textContent = ''; b.el.appendChild(frac(t, d)); });\n  const replayBtn = K.button({ label: 'Play again', secondary: true, into: '#replay', press: () => {\n    if (!STEPS[at()].show || finished) return;\n    start();\n  } });\n  const backBtn = K.button({ label: 'Back', secondary: true, into: '#nav', press: () => {\n    if (finished) { finished = false; return; }\n    stepper.set(Math.max(0, at() - 1), true);\n  } });\n  const nextBtn = K.button({ label: 'Continue', into: '#nav', press: () => {\n    const i = at();\n    if (finished || (!STEPS[i].show && S[i].res !== 'right')) return;\n    if (i < STEPS.length - 1) { stepper.set(i + 1, true); return; }\n    finished = true;\n    if (typeof K.complete === 'function') K.complete();\n  } });\n  const againBtn = K.button({ label: 'Start again', secondary: true, into: '#again', press: () => {\n    S = STEPS.map((d, i) => blank(i)); finished = false; lastStep = -1; stepper.set(0, true);\n  } });\n\n  // One animation plays each demonstration from its start, and an answer's reveal on a DO\n  // screen; with reduced motion both open finished.\n  const anim = K.anim({ button: false, label: 'Demonstration', step: (dt) => {\n    const i = at(), d = STEPS[i];\n    if (finished) return false;\n    T += dt;\n    paint();\n    return T < (d.show ? d.dur : revealEnd(i));\n  } });\n  function start() {\n    if (REDUCE) { T = Infinity; anim.pause(); return; }\n    T = 0; anim.play();\n  }\n  const reveal = start;\n  // Each new screen fades in softly: restart its CSS fade by taking the class off, reflowing once, and putting it back.\n  function enter(box) { box.classList.remove('enter'); void box.offsetWidth; box.classList.add('enter'); }\n\n  // ---------- drawing ----------\n  const svg = document.getElementById('scene');\n  function piece(attrs, i, st, locked) {\n    const r = K.svg('rect', Object.assign({ class: 'pc' + (st.on[i] ? ' on' : '') + (locked ? ' locked' : ''), tabindex: locked ? -1 : 0, role: 'button',\n      'aria-pressed': st.on[i] ? 'true' : 'false', 'aria-label': 'Piece ' + (i + 1) }, attrs));\n    if (!locked) {\n      const flip = () => { st.on[i] = !st.on[i]; changed(); K.reveal(); K.refresh(); };\n      r.addEventListener('click', flip);\n      r.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });\n    }\n    return r;\n  }\n  // A shown (not tappable) piece.\n  const still = (x, y, w, h, on) => svg.appendChild(K.svg('rect', { class: 'pc locked' + (on ? ' on' : ''), x: x, y: y, width: w, height: h }));\n  const edge = (x, y, w, h) => svg.appendChild(K.svg('rect', { class: 'edge', x: x, y: y, width: w, height: h }));\n  // A shown piece whose shade fades in at arrival a: plain before, the shade laid over it while it\n  // comes, then the shaded piece alone (exactly as a still shaded piece).\n  function shade(x, y, w, h, a) {\n    if (a >= 1) return still(x, y, w, h, true);\n    still(x, y, w, h, false);\n    if (a > 0) K.fade(still(x, y, w, h, true), a, 0);\n  }\n\n  // --- the demonstrations (SHOW steps), drawn at time T ---\n  function demoCut() {\n    svg.setAttribute('viewBox', '0 0 340 92');\n    const y = 28, H = 56, W = LW / 4;\n    svg.appendChild(K.svg('rect', { class: 'blank', x: L0, y: y, width: LW, height: H }));\n    text(170, 18, 'one whole', 'tl');\n    let cuts = 0;\n    AT.cut.forEach((t0, k) => {\n      const f = arr(t0, GROW);        // each cut grows down the bar, easing in and out\n      if (f <= 0) return;\n      cuts++;\n      const x = L0 + (k + 1) * W;\n      svg.appendChild(K.svg('line', { class: 'cut', x1: x, y1: y, x2: x, y2: y + H * f }));\n    });\n    edge(L0, y, LW, H);\n    const a = arr(AT.cutLabels), named = a > 0;\n    if (named) for (let k = 0; k < 4; k++) fadeIn(svgFrac(L0 + (k + 0.5) * W, y + 28, 1, 4, 'lab', 'fbar'), a);\n    return 'One whole bar' + (cuts ? ' with ' + cuts + ' of its 3 cuts made' : '') + (named ? ', making 4 equal pieces, each labelled one quarter.' : '.');\n  }\n  function demoCount() {\n    svg.setAttribute('viewBox', '0 0 340 140');\n    const y = 4, H = 56, W = LW / 4;\n    let n = 0;\n    for (let k = 0; k < 4; k++) {\n      const a = k < 3 ? arr(AT.count[k]) : 0, on = a > 0;\n      if (on) n++;\n      shade(L0 + k * W, y, W, H, a);\n      if (on) fadeIn(text(L0 + (k + 0.5) * W, y + 34, k + 1, 'onnum'), a);\n    }\n    edge(L0, y, LW, H);\n    const r = AT.countRule.map((t0) => arr(t0)), rule = r[0] > 0;\n    if (r[0] > 0) fadeIn(svgFrac(60, 104, 3, 4, 'big', 'bbar', 13, 24), r[0]);\n    if (r[1] > 0) fadeIn(text(90, 97, 'counts the pieces', 'tl', 'start'), r[1]);\n    if (r[2] > 0) fadeIn(text(90, 126, 'names the piece', 'tl', 'start'), r[2]);\n    return 'A bar cut into 4 quarters with ' + n + ' shaded and counted' + (rule ? '. Beside 3/4, the 3 counts the pieces and the 4 names the piece.' : '.');\n  }\n  function