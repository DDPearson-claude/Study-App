hild(K.svg('circle', { class: 'dot', cx: xm, cy: Y, r: ad >= 1 ? 9 : 9 * (0.6 + 0.4 * ad) })), ad, 0);\n    if (al > 0) fadeIn(svgFrac(xm, Y + 30, 3, 4, 'mlab', 'mbar'), al);\n    return 'A bar with ' + n + ' of 4 quarters shaded above a number line from 0 to 1' + (landed ? '. A line drops from the end of the shading to a mark at 3/4.' : '.');\n  }\n  function demoCarry() {\n    svg.setAttribute('viewBox', '0 0 340 176');\n    const H = 56, W = LW / 4, ys = [24, 112];\n    let n = 0;\n    for (let b = 0; b < 2; b++) {\n      for (let k = 0; k < 4; k++) {\n        const j = b * 4 + k, a = j < 7 ? arr(AT.carry[j]) : 0, on = a > 0;\n        if (on) n++;\n        shade(L0 + k * W, ys[b], W, H, a);\n        if (on) fadeIn(text(L0 + (k + 0.5) * W, ys[b] + 34, j + 1, 'onnum'), a);\n      }\n      edge(L0, ys[b], LW, H);\n    }\n    const aw = arr(AT.carryWhole), ad = arr(AT.carryDone);\n    if (aw > 0) fadeIn(text(170, 16, 'four quarters, one whole', 'tl'), aw);\n    if (ad > 0) fadeIn(text(L0 + 1.5 * W, 104, 'three more quarters', 'tl'), ad);\n    return 'Two bars of 4 quarters each, with ' + n + ' quarters counted' + (n >= 4 ? ', filling the first bar' : '') + (n > 4 ? ' and ' + (n - 4) + ' of the second.' : '.');\n  }\n\n  // --- the puzzles (DO steps) ---\n  function drawBars(d, st, locked) {\n    const H = 56, GAP = 18, W = LW / d.per;\n    svg.setAttribute('viewBox', '0 0 340 ' + (d.bars * H + (d.bars - 1) * GAP + 8));\n    for (let b = 0; b < d.bars; b++) {\n      const y = 4 + b * (H + GAP);\n      for (let k = 0; k < d.per; k++) svg.appendChild(piece({ x: L0 + k * W, y: y, width: W, height: H }, b * d.per + k, st, locked));\n      edge(L0, y, LW, H);\n    }\n    const n = count(st.on), total = d.bars * d.per;\n    return (d.bars === 1 ? 'A bar' : 'Two bars, one above the other, each') + ' cut into ' + d.per + ' equal pieces. ' + n + ' of the ' + total + ' pieces are coloured.';\n  }\n  function drawSquare(st, locked) {\n    // The other way round from the demonstration: a tall left half, and a right half cut into two quarters.\n    svg.setAttribute('viewBox', '0 0 340 216');\n    const x = 70, y = 6, s = 204;\n    svg.appendChild(piece({ x: x, y: y, width: s / 2, height: s }, 0, st, locked));\n    svg.appendChild(piece({ x: x + s / 2, y: y, width: s / 2, height: s / 2 }, 1, st, locked));\n    svg.appendChild(piece({ x: x + s / 2, y: y + s / 2, width: s / 2, height: s / 2 }, 2, st, locked));\n    edge(x, y, s, s);\n    return 'A square cut into one tall left piece and two small right pieces. ' + count(st.on) + ' of the 3 pieces are coloured.';\n  }\n  function drawLine(d, st, locked, right) {\n    svg.setAttribute('viewBox', '0 0 340 124');\n    const Y = 76, n = 4 * d.wholes, step = LW / n;\n    // Hops from 0 to the mark, once it is right: one arc per quarter-step, fading in one after another.\n    if (right) {\n      for (let k = 0; k < st.mark; k++) {\n        const f = arr(HOP.from + k * HOP.gap);\n        if (f <= 0) continue;\n        const a = tickX(d.wholes, k), b = tickX(d.wholes, k + 1);\n        fadeIn(svg.appendChild(K.svg('path', { class: 'hop', d: 'M' + (a + 2) + ' ' + (Y - 4) + ' Q' + ((a + b) / 2) + ' ' + (Y - 26) + ' ' + (b - 2) + ' ' + (Y - 4) })), f, 0);\n      }\n    }\n    svg.appendChild(K.svg('line', { class: 'axis', x1: L0, y1: Y, x2: L0 + LW, y2: Y }));\n    for (let k = 0; k <= n; k++) {\n      const x = tickX(d.wholes, k), whole = k % 4 === 0;\n      svg.appendChild(K.svg('line', { class: 'tick', x1: x, y1: whole ? Y - 12 : Y - 8, x2: x, y2: whole ? Y + 12 : Y + 8 }));\n      if (whole) text(x, Y + 34, k / 4, 'num');\n    }\n    if (st.mark != null) {\n      const x = tickX(d.wholes, st.mark);\n      svg.appendChild(K.svg('circle', { class: 'dot', cx: x, cy: Y, r: 9 }));\n      const f = right ? arr(HOP.from + st.mark * HOP.gap) : 0;     // the label arrives after the last hop\n      if (f > 0) fadeIn(svgFrac(Math.max(16, Math.min(324, x)), 26, d.want, 4, 'mlab', 'mbar'), f);\n    }\n    // Tap targets: a tall strip around every tick (the nearest tick takes the tap).\n    for (let k = 0; k <= n; k++) {\n      const x = tickX(d.wholes, k);\n      const r = K.svg('rect', { class: 'hit' + (locked ? ' locked' : ''), x: x - step / 2, y: Y - 44, width: step, height: 88, tabindex: locked ? -1 : 0, role: 'button',\n        'aria-label': 'Tick ' + k + ' of ' + n });\n      if (!locked) {\n        const put = () => { st.mark = k; changed(); K.reveal(); K.refresh(); };\n        r.addEventListener('click', put);\n        r.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); put(); } });\n      }\n      svg.appendChild(r);\n    }\n    return 'A number line from 0 to ' + d.wholes + ' with a tick at every quarter. ' +\n      (st.mark == null ? 'No mark yet.' : 'The mark is on tick ' + st.mark + ' of ' + n + '.');\n  }\n  function drawCompare(st) {\n    svg.setAttribute('viewBox', '0 0 340 132');\n    const X = 56, W = 264, H = 46, rows = [{ t: 5, b: 8, y: 6 }, { t: 3, b: 4, y: 78 }];\n    rows.forEach((r, i) => {\n      svgFrac(26, r.y + H / 2 + 2, r.t, r.b, 'lab', 'fbar');\n      svg.appendChild(K.svg('rect', { class: 'blank', x: X, y: r.y, width: W, height: H }));\n      if (!st.shown) return;\n      const a = arr(ROWS[i]);          // each bar's pieces and shading fade in, the top bar first\n      if (a <= 0) return;\n      const w = W / r.b;\n      for (let k = 0; k < r.b; k++) fadeIn(still(X + k * w, r.y, w, H, k < r.t), a, 0);\n      fadeIn(edge(X, r.y, W, H), a, 0);\n    });\n    return st.shown ? 'Two bars of the same length. The top one is cut into 8 pieces with 5 coloured; the bottom one into 4 pieces with 3 coloured.'\n      : 'Two empty bars of the same length, one for 5/8 and one for 3/4.';\n  }\n\n  // The scene for the current step (the animation calls this every frame).\n  function paint() {\n    const i = at(), d = STEPS[i], st = S[i], right = st.res === 'right';\n    looking = document.documentElement.classList.contains('k-testing');\n    svg.textContent = '';\n    let aria;\n    if (d.show) aria = { cut: demoCut, count: demoCount, square: demoSquare, drop: demoDrop, carry: demoCarry }[d.demo]();\n    else if (d.kind === 'bar') aria = drawBars(d, st, right);\n    else if (d.kind === 'square') aria = drawSquare(st, right);\n    else if (d.kind === 'line') aria = drawLine(d, st, right, right);\n    else aria = drawCompare(st);\n    svg.setAttribute('aria-label', aria);\n  }\n\n  const el = (id) => document.getElementById(id);\n  el('finish').textContent = FINISH;\n  K.update((p) => {\n    const i = Math.round(p.step), d = STEPS[i], st = S[i];\n    // A new screen fades in; a demonstration plays from its start; a DO screen opens finished.\n    if (i !== lastStep) { lastStep = i; enter(el('stepbox')); if (d.show) start(); else { anim.pause(); T = Infinity; } }\n    if (finished !== wasDone) { wasDone = finished; enter(el(finished ? 'done' : 'stepbox')); }\n    const right = st.res === 'right';\n    el('stepbox').hidden = finished;\n    el('done').hidden = !finished;\n    el('count').textContent = 'Step ' + (i + 1) + ' of ' + STEPS.length;\n    const task = el('task');\n    task.className = 'task' + (d.show ? ' show' : '');\n    write(task, d.show ? d.text : d.task);\n    paint();\n\n    el('replay').hidden = !d.show || REDUCE;\n    picks.hidden = d.kind !== 'compare';\n    pickA.el.setAttribute('aria-pressed', st.pick === 'a' ? 'true' : 'false');\n    pickB.el.setAttribute('aria-pressed', st.pick === 'b' ? 'true' : 'false');\n\n    el('acts').hidden = !!d.show;\n    checkBtn.el.hidden = right;\n    const fb = el('fb');\n    fb.hidden = !!d.show;\n    fb.className = 'fb' + (right ? ' right' : st.res === 'wrong' ? ' wrong' : '');\n    fb.textContent = d.show ? '' : right ? 'That\\'s it.' : st.res === 'wrong' ? d.hint : st.res === 'empty' ? d.empty : '';\n\n    const why = el('why');\n    why.hidden = d.show || !st.why;\n    write(why, d.show ? '' : d.why);\n    whyBtn.setLabel(st.why ? 'Hide why' : 'Why?');\n\n    backBtn.el.hidden = i === 0 && !finished;\n    nextBtn.el.hidden = finished || (!d.show && !right);\n    nextBtn.setLabel(i === STEPS.length - 1 ? 'Finish' : 'Continue');\n    nav.hidden = backBtn.el.hidden && nextBtn.el.hidden;\n  });\n\n  // ---------- known answers, worked out by hand ----------\n  const bar = (i, n) => isRight(i, Object.assign(blank(i), { on: blank(i).on.map((v, k) => k < n) }));\n  K.check('Bars: one of four quarters is 1/4 and three is 3/4; seven quarters across two bars is 7/4, so 1 3/4; other counts are not', () =>\n    bar(1, 1) && !bar(1, 0) && !bar(1, 2) && bar(3, 3) && !bar(3, 4) && !bar(3, 1) &&\n    bar(10, 7) && !bar(10, 4) && !bar(10, 8) && K.near(7 / 4, 1 + 3 / 4, 1e-12) && 7 - 4 * Math.floor(7 / 4) === 3);\n  K.check('Squares: the big piece alone, or the two small ones together, is half; one small piece, or the big one with a small one, is not', () => {\n    const t = (on) => isRight(5, Object.assign(blank(5), { on: on }));\n    return K.near(SQUARE[0] + SQUARE[1] + SQUARE[2], 1, 1e-12) && t([true, false, false]) && t([false, true, true]) &&\n      !t([false, true, false]) && !t([true, true, false]) && !t([true, true, true]);\n  });\n  K.check('Lines: 3/4 is the third quarter tick, right under the end of three shaded quarters of the bar; 7/4 is three ticks past 1', () => {\n    const one = tickX(1, 4) - L0, two = (tickX(2, 8) - L0) / 2;\n    return K.near((tickX(1, 3) - L0) / one, 0.75, 1e-9) && K.near(tickX(1, 3), L0 + 3 * (LW / 4), 1e-9) &&\n      K.near((tickX(2, 7) - L0) / two, 1.75, 1e-9) &&\n      isRight(7, Object.assign(blank(7), { mark: 3 })) && !isRight(7, Object.assign(blank(7), { mark: 4 })) &&\n      isRight(11, Object.assign(blank(11), { mark: 7 })) && !isRight(11, Object.assign(blank(11), { mark: 3 }));\n  });\n  K.check('Compare: 5/8 is less than 3/4 (0.625 against 0.75), so five of eight pieces fill less of the same bar than three of four', () =>\n    5 / 8 < 3 / 4 && K.near(5 / 8, 0.625, 1e-12) && K.near(3 / 4, 0.75, 1e-12) && 5 * (264 / 8) < 3 * (264 / 4) &&\n    isRight(CMP, Object.assign(blank(CMP), { pick: 'b' })) && !isRight(CMP, Object.assign(blank(CMP), { pick: 'a' })));\n  // Each demonstration's parts as [due, takes] in seconds, read from the timetable above.\n  const soft = (ts) => ts.map((t) => [t, K.SOFT]);\n  const PARTS = {\n    cut: AT.cut.map((t) => [t, GROW]).concat(soft([AT.cutLabels])),\n    count: soft(AT.count.concat(AT.countRule)),\n    square: soft([AT.square, AT.squareHalf].concat(AT.squareSmall)),\n    drop: soft(AT.drop.concat([AT.dropDot, AT.dropLabel])).concat([[AT.dropFrom, AT.dropTo - AT.dropFrom]]),\n    carry: soft(AT.carry.concat([AT.carryWhole, AT.carryDone])),\n  };\n  K.check('Every demonstration has finished arriving within 5 s of its screen opening, its first part only after the screen has faded in; an answer\\'s reveal within 2.5 s', () => {\n    const shows = STEPS.filter((d) => d.show).every((d) => {\n      const p = PARTS[d.demo], first = Math.min.apply(null, p.map((x) => x[0])), last = Math.max.apply(null, p.map((x) => x[0] + x[1]));\n      return first >= FADE_IN && last <= d.dur + 1e-9 && d.dur <= 5;\n    });\n    return shows && AT.carry.length === 7 && STEPS.every((d, i) => d.show || revealEnd(i) <= 2.5);\n  });\n\n  K.ready();\n</script>",
