 "interactive": {
  "html": "<!-- kind: mechanism -->\n<style>\n  .fx .rest { fill: var(--k-panel); }\n  .fx .shaded { fill: var(--k-accent2); }\n  .fx .hatch { fill: url(#fx-hatch); }\n  .fx .edge { fill: none; stroke: var(--k-strong); stroke-width: 1.5; }\n  .fx .qcut { stroke: var(--k-strong); stroke-width: 2.5; }\n  .fx .cut { stroke: var(--k-ink); stroke-width: 2; stroke-dasharray: 1; animation: fx-run .3s ease-out; }\n  .fx .cut.onrun { stroke: var(--k-on-accent2); }\n  .fx .keyt, .fx .lab { font: 16px var(--k-font); fill: var(--k-ink); }\n  .fx .side { font: 600 16px var(--k-font); fill: var(--k-ink); }\n  .fx .name { font: 700 22px var(--k-font); fill: var(--k-accent2); }\n  .fx .name.count { fill: var(--k-ink); }\n  .fx .name .dim { font: 500 17px var(--k-font); fill: var(--k-ink); }\n  .fx .why { font: 16px var(--k-font); fill: var(--k-muted); }\n  .fx #bars { cursor: ew-resize; touch-action: none; }\n  @keyframes fx-run { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }\n</style>\n\n<p class=\"lead\">A rectangle for a circuit's full rated load, 32 A as an example, in four equal upright quarters with the left three shaded: the three-quarter load. A second cut runs across it from the left, through the quarters already there.</p>\n\n<svg class=\"fx\" id=\"scene\" viewBox=\"0 0 340 244\" width=\"100%\" role=\"img\" aria-label=\"\">\n  <defs>\n    <pattern id=\"fx-hatch\" patternUnits=\"userSpaceOnUse\" width=\"7\" height=\"7\" patternTransform=\"rotate(45)\">\n      <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"7\" stroke=\"var(--k-on-accent2)\" stroke-width=\"1.6\" stroke-opacity=\".85\"/>\n    </pattern>\n  </defs>\n  <g id=\"key\">\n    <rect class=\"shaded\" x=\"14\" y=\"4\" width=\"14\" height=\"14\" rx=\"2\"/>\n    <text class=\"keyt\" x=\"34\" y=\"16\">shaded: the three-quarter load</text>\n    <rect class=\"shaded\" x=\"14\" y=\"26\" width=\"14\" height=\"14\" rx=\"2\"/>\n    <rect class=\"hatch\" x=\"14\" y=\"26\" width=\"14\" height=\"14\" rx=\"2\"/>\n    <text class=\"keyt\" x=\"34\" y=\"38\">kept part</text>\n    <line class=\"cut\" x1=\"128\" y1=\"33\" x2=\"142\" y2=\"33\" pathLength=\"1\"/>\n    <text class=\"keyt\" x=\"148\" y=\"38\">the second cut</text>\n  </g>\n  <text class=\"lab\" x=\"14\" y=\"60\">4 quarters, 3 shaded</text>\n  <text class=\"lab\" x=\"270\" y=\"60\" text-anchor=\"end\">whole: 32 A</text>\n  <g id=\"bars\"></g>\n  <g id=\"rows\"></g>\n  <g id=\"names\"></g>\n</svg>\n<div class=\"k-controls\" id=\"controls\"></div>\n<p class=\"say\" id=\"say\"></p>\n<div class=\"k-readouts\" id=\"outs\"></div>\n<p class=\"caption\">Tops by tops and bottoms by bottoms, because the second cut runs across every piece the first cut made.</p>\n\n<script>\n  // Source [2] of the lesson: 3/4 × 1/2 = 3/8. Source [4]: fractions are always divided into equal parts.\n  const SRC_PRODUCT = 'https://www.bbc.co.uk/bitesize/articles/zxdmxbk';\n  const SRC_EQUAL = 'https://www.bbc.co.uk/bitesize/articles/zq2yfrd';\n\n  // The whole: a 32 A rated load (chosen) in 4 quarters (what quarter means), 3 of them shaded (chosen).\n  const WHOLE_A = 32, QUARTERS = 4, SHADED = 3;\n  const QUARTER_A = WHOLE_A / QUARTERS;                 // 32 ÷ 4 = 8 A in one quarter\n  // Each fraction to take: the rows the second cut makes in a quarter (its bottom) and the rows kept (its top).\n  const FR = {\n    'A half': { rows: 2, keep: 1 },\n    'A third': { rows: 3, keep: 1 },\n    'Two thirds': { rows: 3, keep: 2 },\n    'A quarter': { rows: 4, keep: 1 },\n    'Three quarters': { rows: 4, keep: 3 },\n  };\n  const gcd = (a, b) => (b ? gcd(b, a % b) : a);\n  // Amps, written the way the explanation writes them: 12 A, about 2.7 A.\n  const amps = (v) => K.fmt(v, { decimals: Number.isInteger(Math.round(v * 10) / 10) ? 0 : 1 }) + ' A';\n  const about = (v) => (Number.isInteger(Math.round(v * 10) / 10) ? '' : 'about ') + amps(v);\n  const plural = (n, one, many) => n + ' ' + (n === 1 ? one : many);\n\n  // The rule, from the pieces. Pieces in the whole: the quarters not yet crossed plus each crossed\n  // quarter times the rows the cut makes. Pieces kept: the shaded quarters crossed times the rows\n  // kept. The load is worked from amounts: each crossed shaded quarter keeps the chosen fraction of 8 A.\n  function rule(q, f) {\n    const shadedCrossed = Math.min(q, SHADED);\n    const piecesInWhole = (QUARTERS - q) + q * f.rows;\n    const piecesKept = shadedCrossed * f.keep;\n    const loadKept = shadedCrossed * (QUARTER_A * f.keep / f.rows);\n    const equal = q === 0 || q === QUARTERS;\n    let name, simpler = '';\n    if (q === 0) name = SHADED + '/' + QUARTERS;\n    else if (!equal) name = piecesKept + ' of ' + piecesInWhole + ' pieces';\n    else {\n      name = piecesKept + '/' + piecesInWhole;\n      const d = gcd(piecesKept, piecesInWhole);\n      if (d > 1) simpler = (piecesKept / d) + '/' + (piecesInWhole / d);\n    }\n    return { piecesInWhole, piecesKept, loadKept, equal: equal ? 'yes' : 'no', name, simpler };\n  }\n\n  // The cause Dan controls: how far the second cut has run, by the slider or by dragging across the rectangle.\n  const X0 = 14, QW = 64, X1 = X0 + QUARTERS * QW, Y0 = 68, H = 118, Y1 = Y0 + H;\n  K.control({ id: 'quartersCrossed', label: 'Quarters the cut has crossed', min: 0, max: 4, step: 1, value: 0, unit: 'of 4', snap: [3, 4], into: '#controls' });\n  K.choice({ id: 'takeFraction', label: 'Fraction of the shaded to take', options: Object.keys(FR), value: 0, into: '#controls' });\n  K.stage('#scene', '#controls');\n  K.drag('#bars', { control: 'quartersCrossed', toValue: (x) => K.clamp(Math.round((x - X0) / QW), 0, QUARTERS) });\n  K.readout({ id: 'loadKept', label: 'Load of the kept part', fmt: amps, into: '#outs' });\n\n  K.model((p) => rule(p.quartersCrossed, FR[p.takeFraction]));\n\n  const svg = document.getElementById('scene');\n  const g = (id) => { const e = document.getElementById(id); e.textContent = ''; return e; };\n  const text = (cls, x, y, anchor, ...kids) => K.svg('text', { class: cls, x, y, 'text-anchor': anchor }, ...kids);\n\n  function draw(p, o) {\n    const q = p.quartersCrossed, f = FR[p.takeFraction], rowH = H / f.rows;\n    const bars = g('bars');\n    for (let i = 0; i < QUARTERS; i++) {\n      const x = X0 + i * QW, shaded = i < SHADED;\n      bars.appendChild(K.svg('rect', { class: shaded ? 'shaded' : 'rest', x, y: Y0, width: QW, height: H }));\n      if (i >= q) continue;\n      // The cut has crossed this quarter: it is in rows, and in a shaded quarter the top rows are kept.\n      if (shaded) bars.appendChild(K.svg('rect', { class: 'hatch', x, y: Y0, width: QW, height: rowH * f.keep }));\n      for (let r = 1; r < f.rows; r++) {\n        bars.appendChild(K.svg('line', { class: 'cut' + (shaded ? ' onrun' : ''), x1: x, y1: Y0 + r * rowH, x2: x + QW, y2: Y0 + r * rowH, pathLength: 1 }));\n      }\n    }\n    for (let i = 1; i < QUARTERS; i++) bars.appendChild(K.svg('line', { class: 'qcut', x1: X0 + i * QW, y1: Y0, x2: X0 + i * QW, y2: Y1 }));\n    bars.appendChild(K.svg('rect', { class: 'edge', x: X0, y: Y0, width: QUARTERS * QW, height: H, rx: 2 }));\n\n    // Beside the rectangle: the rows the cut makes and how many of them are kept.\n    const rows = g('rows');\n    if (q > 0) {\n      rows.appendChild(text('side', X1 + 7, Y0 + H / 2 - 4, 'start', f.rows + ' rows'));\n      rows.appendChild(text('side', X1 + 7, Y0 + H / 2 + 18, 'start', f.keep + ' kept'));\n    }\n\n    // Beneath: what the picture can honestly call the kept part.\n    const names = g('names');\n    const cx = (X0 + X1) / 2;\n    // An honest name (3/4, 3/8) is drawn as the main thing; a count of unequal pieces is not a name, and is drawn in ink.\n    const name = text('name' + (o.equal === 'yes' ? '' : ' count'), cx, Y1 + 30, 'middle', o.name);\n    if (o.simpler) name.appendChild(K.svg('tspan', { class: 'dim' }, ' = ' + o.simpler));\n    names.appendChild(name);\n    const why = q === 0 ? 'nothing taken yet'\n      : o.equal === 'no' ? 'unequal pieces: no bottom number'\n      : 'tops ' + SHADED + ' × ' + f.keep + ', bottoms ' + QUARTERS + ' × ' + f.rows;\n    names.appendChild(text('why', cx, Y1 + 54, 'middle', why));\n\n    svg.setAttribute('aria-label', 'A rectangle for a 32 A load in 4 upright quarters, 3 of them shaded. ' +\n      (q === 0 ? 'No second cut has run yet, so the label beneath reads 3/4.'\n        : 'A second cut has crossed ' + plural(q, 'quarter', 'quarters') + ' from the left, splitting each into ' + f.rows + ' equal rows, with the top ' + plural(f.keep, 'row', 'rows') + ' of each shaded quarter hatched as the kept part. The label beneath reads ' + o.name + (o.simpler ? ', which is ' + o.simpler : '') + '.'));\n\n    // The sentence: the cause (how far the cut has run), then what that does to the pieces and the name.\n    const perQ = QUARTER_A * f.keep / f.rows;\n    let s;\n    if (q === 0) {\n      s = 'The whole, 32 A, is in 4 equal quarters and 3 are shaded: the three-quarter load, 3 × 8 A = 24 A. No second cut has run yet, so nothing is kept and the label can honestly read 3/4. Run the cut across one quarter and it splits into ' + f.rows + ' rows.';\n    } else if (q < SHADED) {\n      s = 'The cut has crossed ' + plural(q, 'shaded quarter', 'shaded quarters') + ', splitting ' + (q === 1 ? 'it' : 'each') + ' into ' + f.rows + ' equal rows, and the top ' + plural(f.keep, 'row', 'rows') + ' ' + (f.keep === 1 ? 'is' : 'are') + ' kept: ' + plural(o.piecesKept, 'piece', 'pieces') + '. A quarter is 8 A and ' + f.keep + ' of its ' + f.rows + ' rows is ' + about(perQ) + ', so the kept part is ' + amps(o.loadKept) + ' so far. The other ' + (QUARTERS - q) + ' quarters are still whole, so the ' + o.piecesInWhole + ' pieces are of two sizes, and ' + o.piecesKept + ' of ' + o.piecesInWhole + ' is a count, not a fraction.';\n    } else if (q === SHADED) {\n      s = 'The cut has crossed all 3 shaded quarters, so the kept part is complete: ' + f.keep + ' of every quarter\\'s ' + f.rows + ' rows, ' + about(perQ) + ' each, ' + amps(o.loadKept) + ' in all. But the unshaded quarter is still one whole piece, so the whole holds ' + o.piecesInWhole + ' pieces of two sizes, and ' + o.piecesKept + ' of ' + o.piecesInWhole + ' is not a fraction' +\n        (f.rows === 2 && f.keep === 1 ? ': 3/7 of 32 A would be about 13.7 A, not 12 A' : '') + '. Run the cut across the last quarter and the name appears.';\n    } else {\n      s = 'The cut has crossed all 4 quarters, the unshaded one too, so every quarter is in ' + f.rows + ' rows and the whole is 4 × ' + f.rows + ' = ' + o.piecesInWhole + ' equal pieces. The kept part is 3 shaded quarters wide and ' + plural(f.keep, 'row', 'rows') + ' tall, 3 × ' + f.keep + ' = ' + o.piecesKept + ' of them: ' + o.name + (o.simpler ? ', which is ' + o.simpler : '') + '. Tops multiplied over bottoms multiplied, and the load has not moved: still ' + amps(o.loadKept) +\n        (f.rows === 2 && f.keep === 1 ? ', because an eighth of 32 A is 4 A and 3 × 4 = 12 A' : '') + '.';\n    }\n    document.getElementById('say').textContent = s;\n  }\n  K.update(draw);\n\n  // Known answers, worked out by hand.\n  K.check('Nothing crossed: 4 quarters, 0 pieces kept, 0 A, and the label reads 3/4', () => {\n    const o = K.at({ quartersCrossed: 0 });\n    return o.piecesInWhole === 4 && o.piecesKept === 0 && o.loadKept === 0 && o.name === '3/4' && o.equal === 'yes';\n  });\n  K.check('For a half the pieces in the whole climb 4, 5, 6, 7, 8 as the cut crosses each quarter, 3 + 1 × 2 = 5 and so on, and only at 0 and 4 crossed are they all equal', () =>\n    [4, 5, 6, 7, 8].every((n, q) => K.at({ quartersCrossed: q, takeFraction: 'A half' }).piecesInWhole === n) &&\n    [0, 1, 2, 3, 4].every((q) => (K.at({ quartersCrossed: q, takeFraction: 'A half' }).equal === 'yes') === (q === 0 || q === 4)));\n  K.check('At 4 crossed for a half, 3 × 1 = 3 pieces kept of 4 × 2 = 8: the label reads 3/8', () => {\n    const o = K.at({ quartersCrossed: 4, takeFraction: 'A half' });\n    return o.piecesKept === 3 * 1 && o.piecesInWhole === 4 * 2 && o.name === '3/8' && o.simpler === '';\n  });\n  K.check('Half of three-quarters is three-quarters multiplied by a half, three-eighths', () =>\n    K.at({ quartersCrossed: 4, takeFraction: 'A half' }).name === '3/8' && K.near(3 / 4 * (1 / 2), 3 / 8, 1e-9), { source: SRC_PRODUCT });\n  K.check('By amounts, 3 crossed shaded quarters keep 3 × (8 ÷ 2) = 12 A, still 12 A at 4 crossed; 3/8 of 32 A is 3 × 4 = 12 A too, while 3/7 of 32 A would be about 13.7 A', () =>\n    K.near(K.at({ quartersCrossed: 3, takeFraction: 'A half' }).loadKept, 3 * (8 / 2), 1e-9) && K.near(K.at({ quartersCrossed: 4, takeFraction: 'A half' }).loadKept, 12, 1e-9) &&\n    K.near(3 * (32 / 8), 12, 1e-9) && K.near(32 * 3 / 7, 13.7, 0.05) && !K.near(32 * 3 / 7, 12, 0.5));\n  K.check('The ends for the other choices: a third 3/12 = 1/4 and 8 A, two thirds 6/12 = 1/2 and 16 A, a quarter 3/16 and 6 A, three quarters 9/16 and 18 A', () =>\n    [['A third', '3/12', '1/4', 8], ['Two thirds', '6/12', '1/2', 16], ['A quarter', '3/16', '', 6], ['Three quarters', '9/16', '', 18]].every(([c, n, s, a]) => {\n      const o = K.at({ quartersCrossed: 4, takeFraction: c });\n      return o.name === n && o.simpler === s && K.near(o.loadKept, a, 1e-9) && o.piecesKept === 3 * FR[c].keep && o.piecesInWhole === 4 * FR[c].rows;\n    }));\n  K.check('Keeping the bottom, 2/4 × 3/4 = 6/4, would mean 48 A on a 32 A circuit; the kept part never exceeds the 24 A shaded load', () =>\n    K.near(6 / 4 * 32, 48, 1e-9) && 48 > 32 && Object.keys(FR).every((c) => [0, 1, 2, 3, 4].every((q) => K.at({ quartersCrossed: q, takeFraction: c }).loadKept <= 24 + 1e-9)));\n  K.check('The label names a fraction of the whole only while every piece of the whole is equal', () =>\n    Object.keys(FR).every((c) => [0, 1, 2, 3, 4].every((q) => {\n      const o = K.at({ quartersCrossed: q, takeFraction: c });\n      return (o.equal === 'yes') === (q === 0 || q === 4) && (o.name.indexOf('/') >= 0) === (o.equal === 'yes');\n    })), { source: SRC_EQUAL });\n\n  K.ready();\n</script>",
