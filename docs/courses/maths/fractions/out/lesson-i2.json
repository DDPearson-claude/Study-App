s 6 sixteenths: 3/8 inch = 6/16 inch.' : '.');\n  }\n  function drawLine(d, st, locked, right) {\n    svg.setAttribute('viewBox', '0 0 340 124');\n    const Y = 76, n = d.per, step = LW / n;\n    if (right) {               // once right, the hops from 0 to the mark fade in one after another\n      for (let k = 0; k < st.mark; k++) {\n        const h = arr(REVEAL.hop + k * REVEAL.hopGap);\n        if (h <= 0) continue;\n        const a = tickX(k, n), b = tickX(k + 1, n);\n        fadeIn(svg.appendChild(K.svg('path', { class: 'hop', d: 'M' + (a + 2) + ' ' + (Y - 4) + ' Q' + ((a + b) / 2) + ' ' + (Y - 24) + ' ' + (b - 2) + ' ' + (Y - 4) })), h, 0);\n      }\n    }\n    svg.appendChild(K.svg('line', { class: 'axis', x1: L0, y1: Y, x2: L0 + LW, y2: Y }));\n    for (let k = 0; k <= n; k++) {\n      const x = tickX(k, n), h = k % n === 0 ? 12 : k % 2 === 0 ? 9 : 6;\n      svg.appendChild(K.svg('line', { class: 'tick', x1: x, y1: Y - h, x2: x, y2: Y + h }));\n    }\n    text(L0, Y + 34, 0, 'num'); text(L0 + LW, Y + 34, 1, 'num');\n    if (st.mark != null) {\n      const x = tickX(st.mark, n);\n      svg.appendChild(K.svg('circle', { class: 'dot', cx: x, cy: Y, r: 9 }));\n      const al = right ? arr(REVEAL.hop + st.mark * REVEAL.hopGap) : 0;     // the label arrives after the last hop\n      if (al > 0) { fadeIn(svgFrac(x - 24, 26, 6, 8, 'mlab', 'mbar'), al); fadeIn(text(x, 31, '=', 'mlab'), al); fadeIn(svgFrac(x + 24, 26, 3, 4, 'mlab', 'mbar'), al); }\n    }\n    // Tap targets: a tall strip around every tick (the nearest tick takes the tap).\n    for (let k = 0; k <= n; k++) {\n      const x = tickX(k, n);\n      const r = K.svg('rect', { class: 'hit' + (locked ? ' locked' : ''), x: x - step / 2, y: Y - 44, width: step, height: 88, tabindex: locked ? -1 : 0, role: 'button',\n        'aria-label': 'Tick ' + k + ' of ' + n });\n      if (!locked) {\n        const put = () => { st.mark = k; st.res = null; K.reveal(); K.refresh(); };\n        r.addEventListener('click', put);