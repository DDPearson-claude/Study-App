  "html": "<!-- kind: concept -->\n<style>\n  [hidden] { display: none !important; }\n  .pz { max-width: 30rem; }\n  .pz > * + *, #stepbox > * + * { margin-top: 14px; }\n  /* The stepper is the page's step control: its dots are the progress bar; Back and Continue are below. */\n  .pz .k-stepper { gap: 0; }\n  .pz .k-stepper .k-label, .pz .k-stepper-nav { display: none; }\n  .pz .count { margin-top: 10px; }\n  .task { font-size: 1.2rem; font-weight: 700; line-height: 1.5; margin-top: 4px; }\n  .task.show { font-size: 1.12rem; font-weight: 400; line-height: 1.6; }\n  .fr { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; line-height: 1.1; font-weight: 700; margin: 0 .1em; font-size: .9em; }\n  .fr .n { border-bottom: 2px solid currentColor; padding: 0 .18em; }\n  .fr .d { padding: 0 .18em; }\n  .scene { display: block; width: 100%; }\n  .scene .pc { fill: var(--k-panel); stroke: var(--k-strong); stroke-width: 2; }\n  .scene .pc.on { fill: var(--k-accent2); }\n  .scene .edge { fill: none; stroke: var(--k-strong); stroke-width: 2.5; }\n  .scene .blank { fill: var(--k-panel); stroke: var(--k-strong); stroke-width: 2.5; }\n  .scene .cut { stroke: var(--k-strong); stroke-width: 2; }\n  .scene .axis { stroke: var(--k-ink); stroke-width: 2.5; stroke-linecap: round; }\n  .scene .tick { stroke: var(--k-ink); stroke-width: 2; }\n  .scene .num { font: 700 16px var(--k-font); fill: var(--k-ink); }\n  .scene .lab { font: 700 15px var(--k-font); fill: var(--k-ink); }\n  .scene .big { font: 700 22px var(--k-font); fill: var(--k-ink); }\n  .scene .fbar { stroke: var(--k-ink); stroke-width: 1.5; }\n  .scene .bbar { stroke: var(--k-ink); stroke-width: 2; }\n  .scene .onnum { font: 700 16px var(--k-font); fill: var(--k-on-accent2); }\n  .scene .onsm { font: 700 14px var(--k-font); fill: var(--k-on-accent2); }\n  .scene .tl { font: 700 15px var(--k-font); fill: var(--k-accent); }\n  .scene .arw { fill: none; stroke: var(--k-accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n  .scene .gapbox { fill: none; stroke: var(--k-accent2); stroke-width: 2; stroke-dasharray: 4 3; }\n  .scene .drop { stroke: var(--k-accent2); stroke-width: 2; stroke-dasharray: 5 4; }\n  .scene .hit { fill: var(--k-bg); fill-opacity: 0; cursor: pointer; }\n  .scene .hit.locked { cursor: default; }\n  .scene .hit:focus { outline: none; }\n  .scene .hit:focus-visible { stroke: var(--k-accent); stroke-width: 4; }\n  .scene .dot { fill: var(--k-accent2); stroke: var(--k-bg); stroke-width: 2.5; }\n  .scene .hop { fill: none; stroke: var(--k-accent); stroke-width: 2; }\n  .scene .mlab { font: 700 15px var(--k-font); fill: var(--k-accent2); }\n  .scene .mbar { stroke: var(--k-accent2); stroke-width: 1.5; }\n  .row { display: flex; flex-wrap: wrap; gap: 10px; }\n  .row .k-btn { flex: 1 1 7rem; }\n  .replay { display: flex; justify-content: flex-end; }\n  .replay .k-btn { flex: 0 0 auto; min-height: 44px; padding-left: 16px; padding-right: 16px; font-size: .95rem; }\n  .tools .k-btn { min-height: 48px; }\n  .picks .k-btn { font-size: 1.15rem; min-height: 56px; flex: 1 1 3.5rem; min-width: 0; }\n  .picks .k-btn[aria-pressed=\"true\"] { background: var(--k-accent2); color: var(--k-on-accent2); border-color: var(--k-accent2); }\n  .fb { font-weight: 700; min-height: 1.5em; margin-top: 10px; }\n  .fb.right { color: var(--k-good); }\n  .fb.wrong { color: var(--k-ink); }\n  .why { line-height: 1.6; }\n  .done { line-height: 1.6; }\n  .done strong { color: var(--k-accent2); }\n  .done .row { margin-top: 14px; }\n  /* Each new screen fades in softly, rising 4 px into place (restarted by enter() below). Off for\n     reduced motion, and while the self-test looks, as the kit's own fade-ins are. */\n  .enter { animation: soft-in .35s ease-out backwards; }\n  @keyframes soft-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }\n  html.k-testing .enter { animation: none; }\n  @media (prefers-reduced-motion: reduce) { .enter { animation: none; } }\n</style>\n\n<p class=\"lead\">Bars cut into pieces and a number line, one small step at a time.</p>\n\n<div class=\"pz\" id=\"pz\">\n  <div id=\"prog\"></div>\n  <div id=\"stepbox\">\n    <p class=\"k-label count\" id=\"count\"></p>\n    <p class=\"task\" id=\"task\"></p>\n    <svg class=\"scene\" id=\"scene\" viewBox=\"0 0 340 80\" width=\"100%\" role=\"img\" aria-label=\"\"></svg>\n    <div class=\"replay\" id=\"replay\"></div>\n    <div class=\"row tools\" id=\"tools\"></div>\n    <div class=\"row picks\" id=\"picks\"></div>\n    <div class=\"row acts\" id=\"acts\"></div>\n    <p class=\"fb\" id=\"fb\" aria-live=\"polite\"></p>\n    <div class=\"note why\" id=\"why\" hidden></div>\n  </div>\n  <div class=\"panel done\" id=\"done\" hidden>\n    <p><strong id=\"finish\"></strong></p>\n    <div class=\"row\" id=\"again\"></div>\n  </div>\n  <div class=\"row nav\" id=\"nav\"></div>\n</div>\n\n<p class=\"caption\">Every bar here is one whole, and the bars on each screen are the same length.</p>\n\n<script>\n  // ---------- the lesson: SHOW steps demonstrate, DO steps are puzzles ----------\n  const PICK = 'Tap one of the answers.', EMPTY_LINE = 'Tap the line to place a mark.';\n  const STEPS = [\n    { show: true, demo: 'split', dur: 4.1, name: 'Cut every piece in two',\n      text: 'This bar shows 3/4. Cut every piece in two and it shows 6/8. The shaded amount hasn\\'t changed, so 3/4 and 6/8 are *equivalent*.' },\n    { kind: 'cut', given: [1, 4], opts: ['2/4', '2/8', '1/8'], want: '2/8', dur: 0.6, name: 'Cut a quarter in two',\n      task: 'This bar shows 1/4. Cut each piece in two, then pick its new name.',\n      why: 'Cutting each piece in two makes 8 pieces, and the shaded quarter becomes 2 of them. The amount stays the same.',\n      hint: 'Not quite. Count the shaded pieces after the cut.',\n      hints: { '2/4': 'Not quite. The pieces are eighths now.' } },\n    { show: true, demo: 'times', dur: 4.3, name: 'Times 3, top and bottom',\n      text: 'Cut each third into 3 and there are 3 times as many pieces, and 3 times as many shaded. So 2/3 becomes 6/9. The top and the bottom are both multiplied by 3.' },\n    { kind: 'gap', given: [3, 4], bottom: 8, opts: ['3', '4', '6', '8'], want: '6', name: 'Fill in the gap',\n      task: 'What goes in the gap?',\n      why: 'The bottom went from 4 to 8, so every quarter was cut in two. Each shaded quarter became two eighths, so the top doubles too.',\n      hint: 'Not quite. The bottom doubled, so the top doubles too.',\n      hints: { '3': 'Not quite. The pieces got smaller, so you need more of them.',\n        '4': 'Not quite. Cutting each piece in two doubles the top as well.',\n        '8': 'Not quite. 8/8 would fill the whole bar.' } },\n    { kind: 'pick', given: [3, 5], opts: ['4/6', '3/10', '6/10'], want: '6/10', name: 'The same amount',\n      task: 'This bar shows 3/5. Which of these is the same amount?',\n      why: 'Multiply the top and the bottom by 2. Each fifth becomes two tenths, so three fifths become six tenths.',\n      hint: 'Not quite. Compare the shaded amounts.',\n      hints: { '4/6': 'Adding 1 to the top and bottom changes the amount. Multiply instead.',\n        '3/10': 'Not quite. Tenths are smaller, so you need more of them.' } },\n    { show: true, demo: 'join', dur: 4.5, name: 'Join pieces back',\n      text: 'Now go back the other way. Join the pieces in pairs and 6/8 becomes 3/4. Joining divides the top and the bottom by the same number. Joining as far as it will go is called *simplifying*.' },\n    { kind: 'pick', given: [4, 8], opts: ['2/4', '3/7', '1/2'], want: '1/2', name: 'Simplify 4/8',\n      task: 'Simplify 4/8 as far as it goes.',\n      why: 'Divide the top and the bottom by 4. Four eighths join into one half, and a single shaded piece has no shaded partner to join, so 1/2 is as simple as it gets.',\n      hint: 'Not quite. Compare the shaded amounts.',\n      hints: { '2/4': 'Equal, but you can join the pieces again.',\n        '3/7': 'Taking the same number off the top and bottom changes the amount. Divide instead.' } },\n    { kind: 'pick', given: [6, 9], opts: ['3/6', '2/3', '1/3'], want: '2/3', name: 'Simplify 6/9',\n      task: 'Simplify 6/9.',\n      why: 'Divide the top and the bottom by 3. Each group of three ninths joins into one third.',\n      hint: 'Not quite. Compare the shaded amounts.',\n      hints: { '3/6': 'Taking 3 off the top and bottom changes the amount. Divide instead.',\n        '1/3': 'Not quite. Divide the top by the same number as the bottom.' } },\n    { show: true, demo: 'line', dur: 4.1, name: 'One place on the line',\n      text: 'The bars for 1/2, 2/4 and 4/8 shade the same amount. Drop down to the line and all three land on one mark. Equivalent fractions sit at the same place on the line.' },\n    { kind: 'line', per: 8, want: 6, name: 'Find 6/8 on the line',\n      task: 'Tap where 6/8 goes on the line.',\n      why: 'Six eighth-steps from 0 land on the same mark as three quarter-steps. So 6/8 and 3/4 are the same number.',\n      hint: 'Not quite. Count six eighth-steps from 0.' },\n    { kind: 'pick', draw: 'ruler', given: [3, 8], opts: ['3/16', '6/16', '12/16'], want: '6/16', name: 'A drill bit in sixteenths',\n      task: 'A drill bit is 3/8 inch. How many sixteenths is that?',\n      why: 'An eighth is two sixteenths, so multiply the top and the bottom by 2. A 3/8 inch bit is 6/16 inch.',\n      hint: 'Not quite. An eighth is two sixteenths.',\n      hints: { '12/16': 'Not quite. That is twice as wide as the bit.' } },\n    { kind: 'pick', given: [1, 2], not: true, opts: ['3/6', '2/3', '5/10'], want: '2/3', name: 'Not a half',\n      task: 'Which of these is not equal to 1/2?',\n      why: '3/6 and 5/10 both simplify to 1/2. Two thirds is more than a half.',\n      hint: 'Not quite. Its bar lines up with the half, so it is equal.' },\n  ];\n  const FINISH = 'Multiply or divide the top and bottom by the same number, any but 0, and the fraction keeps its size.';\n  // When each demonstration's parts arrive, in seconds after the screen opens. Each part takes\n  // K.SOFT (0.6 s) to arrive, fading in; the first comes once the screen itself has faded in.\n  const AT = {\n    split: [0.5, 1.0, 1.5, 2.0], splitCount: 2.6, splitName: 3.15, splitEq: 3.5,    // each quarter's cut grows down the bar, the shaded eighths are\n                                                                                     //   counted, then 3/4 slides aside and = 6/8 arrives\n    times: [0.5, 1.1, 1.7], timesCount: 2.3, timesName: 2.9, timesArrow: 3.3, timesNew: 3.7,   // each third is cut into 3, the shaded ninths\n                                                                                     //   counted, then 2/3 slides aside, the x3 arrows arrive, then 6/9\n    join: [0.5, 1.0, 1.5, 2.0], joinCount: 2.6, joinName: 3.15, joinArrow: 3.5, joinNew: 3.9,  // each pair's line shrinks away, the quarters\n                                                                                     //   are counted, then 6/8 slides aside, the /2 arrows, then 3/4\n    line: [0.5, 1.1, 1.7], lineFrom: 2.3, lineTo: 3.0, lineDot: 2.9, lineLabel: 3.5,  // three bars shade, a line eases down to the number\n                                                                                     //   line, where the mark arrives, then 1/2 = 2/4 = 4/8\n    cut: 0.6,                                                         // a DO-step cut grows down the bar over this long\n  };\n  const FADE_IN = 0.35, GROW = 0.6, SLIDE = 0.5;   // the screen's own fade-in; how long a cut grows (or a join shrinks); a name sliding aside\n  // After Check on a DO screen the picture's new parts arrive softly too: the cuts grow down the bar,\n  // then the count, then the new name; a compared bar fades in under the first, then the line drops\n  // between them; on the line, the hops one after another from 0, then the label.\n  const REVEAL = { cut: 0.15, count: 0.75, name: 1.3, bar: 0.1, drop: 0.7, hop: 0.15, hopGap: 0.2 };\n  // Drawing sizes, in viewBox units (340 wide): bars and lines run from x = 20 to x = 320.\n  const L0 = 20, LW = 300;\n  const tickX = (k, n) => L0 + (k / n) * LW;           // the k-th of n equal steps along a 0..1 line\n  const REDUCE = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);\n\n  // ---------- answers (pure, so the checks can test them) ----------\n  const parse = (s) => String(s).split('/').map(Number);\n  const same = (a, b) => a[0] * b[1] === b[0] * a[1];        // equal amounts: cross-multiplied\n  const gcd = (a, b) => (b ? gcd(b, a % b) : a);\n  function blank() { return { mark: null, pick: null, res: null, why: false, cut: false }; }\n  function isEmpty(i, st) {\n    const d = STEPS[i];\n    if (d.kind === 'cut') return !st.cut || st.pick == null;\n    if (d.kind === 'line') return st.mark == null;\n    return st.pick == null;\n  }\n  function isRight(i, st) {\n    const d = STEPS[i];\n    if (d.kind === 'line') return st.mark === d.want;\n    if (d.kind === 'cut') return st.cut && st.pick === d.want;\n    return st.pick === d.want;\n  }\n\n  let S = STEPS.map(() => blank());\n  let finished = false, lastStep = -1, wasDone = false, T = 0;   // T: seconds into the current demonstration (or cut, or answer's reveal)\n  // How far a part due at t0 has arrived at time T (0 before, easing up to 1; 1 when T is Infinity).\n  // While the self-test looks (html.k-testing) a part already on its way is shown arrived, as the\n  // kit's own fade-ins are, so it judges the finished part, not a frame of its fade.\n  let looking = false;\n  const arr = (t0, dur) => { const a = K.arrive(T, t0, dur); return looking && a > 0 ? 1 : a; };\n  // Fade parts in at arrival a: numbers, fractions and labels rise 6 units into place; shapes stay put (rise 0).\n  const fadeIn = (els, a, rise) => { [].concat(els).forEach((e) => K.fade(e, a, rise)); return els; };\n  // The end of the motion on DO step i: a cut growing, or an answer's reveal (0 when nothing moves).\n  function revealEnd(i) {\n    const d = STEPS[i];\n    if (d.kind === 'cut') return AT.cut;\n    if (d.kind === 'gap') return REVEAL.count + K.SOFT;\n    if (d.kind === 'line') return REVEAL.hop + d.want * REVEAL.hopGap + K.SOFT;\n    if (d.draw === 'ruler') return REVEAL.name + K.SOFT;\n    if (d.kind === 'pick') return REVEAL.drop + GROW;\n    return 0;\n  }\n\n  // ---------- text with stacked fractions and amber key terms (built with K.el, never innerHTML) ----------\n  function frac(t, b) {\n    return K.el('span', { class: 'fr', role: 'img', 'aria-label': t + '/' + b },\n      K.el('span', { class: 'n', 'aria-hidden': 'true' }, t), K.el('span', { class: 'd', 'aria-hidden': 'true' }, b));\n  }\n  function write(el, text) {\n    el.textContent = '';\n    const re = /\\*([^*]+)\\*|(\\d+)\\/(\\d+)/g;\n    let at = 0, m;\n    while ((m = re.exec(text))) {\n      if (m.index > at) el.appendChild(document.createTextNode(text.slice(at, m.index)));\n      el.appendChild(m[1] ? K.el('span', { class: 'term' }, m[1]) : frac(m[2], m[3]));\n      at = m.index + m[0].length;\n    }\n    if (at < text.length) el.appendChild(document.createTextNode(text.slice(at)));\n  }\n  // A stacked fraction drawn in the SVG, centred on x, its bar at y.\n  function svgFrac(x, y, t, b, cls, barCls, half, gap) {\n    half = half || 9; gap = gap || 16;\n    return [\n      svg.appendChild(K.svg('text', { class: cls, x: x, y: y - 5, 'text-anchor': 'middle' }, String(t))),\n      svg.appendChild(K.svg('line', { class: barCls, x1: x - half, y1: y, x2: x + half, y2: y })),\n      svg.appendChild(K.svg('text', { class: cls, x: x, y: y + gap, 'text-anchor': 'middle' }, String(b))),\n    ];\n  }\n  const bigFrac = (x, y, t, b) => svgFrac(x, y, t, b, 'big', 'bbar', 13, 24);\n  const text = (x, y, s, cls, anchor) => svg.appendChild(K.svg('text', { class: cls, x: x, y: y, 'text-anchor': anchor || 'middle' }, String(s)));\n\n  // ---------- controls ----------\n  const stepper = K.stepper({ id: 'step', label: 'Step', steps: STEPS.map((d) => d.name), value: 0, compact: true, into: '#prog' });\n  const nav = document.getElementById('nav');\n  const at = () => stepper.get();\n\n  const cutBtn = K.button({ label: 'Cut each piece in two', secondary: true, into: '#tools', press: () => {\n    const i = at(), st = S[i];\n    if (finished || STEPS[i].kind !== 'cut' || st.cut) return;\n    st.cut = true; st.res = null;\n    if (REDUCE) { T = Infinity; return; }\n    T = 0; anim.play();\n  } });\n  // Up to four answer buttons; each step fills in its own options.\n  const pickBtns = [0, 1, 2, 3].map((k) => K.button({ label: 'Answer ' + (k + 1), secondary: true, into: '#picks', press: () => {\n    const i = at(), d = STEPS[i], st = S[i];\n    if (finished || d.show || !d.opts || k >= d.opts.length || st.res === 'right') return;\n    st.pick = d.opts[k]; st.res = null;\n  } }));\n  const checkBtn = K.button({ label: 'Check', into: '#acts', press: () => {\n    const i = at(), st = S[i];\n    if (STEPS[i].show || finished) return;\n    if (isEmpty(i, st)) { st.res = 'empty'; return; }\n    const was = st.res, d = STEPS[i];\n    st.res = isRight(i, st) ? 'right' : 'wrong';\n    // What the answer adds to the picture arrives softly: a compared bar (right or wrong), or what a right answer shows.\n    if (st.res !== was && (st.res === 'right' ? d.kind !== 'cut' : d.kind === 'pick' && !d.draw)) start();\n  } });\n  const whyBtn = K.button({ label: 'Why?', secondary: true, into: '#acts', press: () => {\n    if (STEPS[at()].show || finished) return;\n    const st = S[at()]; st.why = !st.why;\n  } });\n  const replayBtn = K.button({ label: 'Play again', secondary: true, into: '#replay', press: () => {\n    if (!STEPS[at()].show || finished) return;\n    start();\n  } });\n  const backBtn = K.button({ label: 'Back', secondary: true, into: '#nav', press: () => {\n    if (finished) { finished = false; return; }\n    stepper.set(Math.max(0, at() - 1), true);\n  } });\n  const nextBtn = K.button({ label: 'Continue', into: '#nav', press: () => {\n    const i = at();\n    if (finished || (!STEPS[i].show && S[i].res !== 'right')) return;\n    if (i < STEPS.length - 1) { stepper.set(i + 1, true); return; }\n    finished = true;\n    if (typeof K.complete === 'function') K.complete();\n  } });\n  const againBtn = K.button({ label: 'Start again', secondary: true, into: '#again', press: () => {\n    S = STEPS.map(() => blank()); finished = false; lastStep = -1; stepper.set(0, true);\n  } });\n\n  // One animation plays each demonstration from its start, and a cut or an answer's reveal on a DO\n  // screen; with reduced motion they open finished.\n  const anim = K.anim({ button: false, label: 'Demonstration', step: (dt) => {\n    const i = at(), d = STEPS[i];\n    if (finished) return false;\n    T += dt;\n    paint();\n    return T < (d.show ? d.dur : revealEnd(i));\n  } });\n  function start() {\n    if (REDUCE) { T = Infinity; anim.pause(); return; }\n    T = 0; anim.play();\n  }\n  // Each new screen fades in softly: restart its CSS fade by taking the class off, reflowing once, and putting it back.\n  function enter(box) { box.classList.remove('enter'); void box.offsetWidth; box.classList.add('enter'); }\n\n  // ---------- drawing ----------\n  const svg = document.getElementById('scene');\n  const still = (x, y, w, h, on) => svg.appendChild(K.svg('rect', { class: 'pc' + (on ? ' on' : ''), x: x, y: y, width: w, height: h }));\n  const edge = (x, y, w, h) => svg.appendChild(K.svg('rect', { class: 'edge', x: x, y: y, width: w, height: h }));\n  // A bar of n equal pieces with the first t shaded (its pieces and outline, to fade in together).\n  function barOf(x, y, w, h, t, n) {\n    const els = [];\n    for (let k = 0; k < n; k++) els.push(still(x + k * w / n, y, w / n, h, k < t));\n    els.push(edge(x, y, w, h));\n    return els;\n  }\n  // A piece whose shade fades in at arrival a: plain before, the shade laid over it while it\n  // comes, then the shaded piece alone (exactly as a still shaded piece).\n  function shade(x, y, w, h, a) {\n    if (a >= 1) return still(x, y, w, h, true);\n    still(x, y, w, h, false);\n    if (a > 0) K.fade(still(x, y, w, h, true), a, 0);\n  }\n  // A cut line through a bar, grown to fraction f of its height (from the top).\n  const cutLine = (x, y, h, f) => { if (f > 0) svg.appendChild(K.svg('line', { class: 'cut', x1: x, y1: y, x2: x, y2: y + h * f })); };\n  // Count the first n of the pieces (each w wide) along a bar.\n  const countOn = (y, w, n) => { const els = []; for (let j = 0; j < n; j++) els.push(text(L0 + (j + 0.5) * w, y + 34, j + 1, 'onnum')); return els; };\n  // Two arrows from one stacked fraction to the next, each labelled (x3 or /2), above and below,\n  // arriving at a: the arrows fade in where they are, their labels rise into place.\n  function arrows(x1, x2, y, label, a) {\n    [y - 13, y + 16].forEach((ay) => {\n      fadeIn(svg.appendChild(K.svg('path', { class: 'arw', d: 'M' + x1 + ' ' + ay + ' L' + x2 + ' ' + ay + ' M' + (x2 - 7) + ' ' + (ay - 5) + ' L' + x2 + ' ' + ay + ' L' + (x2 - 7) + ' ' + (ay + 5) })), a, 0);\n    });\n    fadeIn(text((x1 + x2) / 2, y - 20, label, 'tl'), a);\n    fadeIn(text((x1 + x2) / 2, y + 36, label, 'tl'), a);\n  }\n\n  // --- the demonstrations (SHOW steps), drawn at time T ---\n  function demoSplit() {\n    svg.setAttribute('viewBox', '0 0 340 152');\n    const y = 4, H = 56, W = LW / 4;\n    for (let k = 0; k < 4; k++) still(L0 + k * W, y, W, H, k < 3);\n    let cuts = 0;\n    AT.split.forEach((t0, k) => { const f = arr(t0, GROW); if (f > 0) cuts++; cutLine(L0 + (k + 0.5) * W, y, H, f); });   // each cut grows down the bar, easing in and out\n    edge(L0, y, LW, H);\n    const ac = arr(AT.splitCount), as = arr(AT.splitName, SLIDE), ae = arr(AT.splitEq), counted = ac > 0, named = as > 0;\n    if (counted) fadeIn(countOn(y, W / 2, 6), ac);\n    bigFrac(K.lerp(170, 125, as), 116, 3, 4);       // 3/4 slides aside, easing, to make room\n    if (ae > 0) { fadeIn(text(170, 124, '=', 'big'), ae); fadeIn(bigFrac(215, 116, 6, 8), ae); }\n    return 'A bar of 4 quarters with 3 shaded, named 3/4' + (cuts ? ', with ' + cuts + ' of the 4 quarters cut in two' : '') +\n      (counted ? '. The 6 shaded eighths are counted' : '') + (named ? ', and 3/4 = 6/8.' : '.');\n  }\n  function demoTimes() {\n    svg.setAttribute('viewBox', '0 0 340 164');\n    const y = 4, H = 56, W = LW / 3;\n    for (let k = 0; k < 3; k++) still(L0 + k * W, y, W, H, k < 2);\n    let cuts = 0;\n    AT.times.forEach((t0, k) => {\n      const f = arr(t0, GROW);        // a third's two cuts grow down the bar together, easing in and out\n      if (f > 0) cuts++;\n      cutLine(L0 + (k + 1 / 3) * W, y, H, f); cutLine(L0 + (k + 2 / 3) * W, y, H, f);\n    });\n    edge(L0, y, LW, H);\n    const ac = arr(AT.timesCount), as = arr(AT.timesName, SLIDE), aa = arr(AT.timesArrow), an = arr(AT.timesNew);\n    const counted = ac > 0, named = as > 0;\n    if (counted) fadeIn(countOn(y, W / 3, 6), ac);\n    bigFrac(K.lerp(170, 95, as), 118, 2, 3);        // 2/3 slides aside, easing, to make room\n    if (aa > 0) arrows(122, 214, 118, '×3', aa);\n    if (an > 0) fadeIn(bigFrac(245, 118, 6, 9), an);\n    return 'A bar of 3 thirds with 2 shaded, named 2/3' + (cuts ? ', with ' + cuts + ' of the 3 thirds cut into 3' : '') +\n      (counted ? '. The 6 shaded ninths are counted' : '') + (named ? ', and the top and bottom are both multiplied by 3, making 6/9.' : '.');\n  }\n  function demoJoin() {\n    svg.setAttribute('viewBox', '0 0 340 164');\n    const y = 4, H = 56, W = LW / 4;\n    for (let k = 0; k < 4; k++) still(L0 + k * W, y, W, H, k < 3);\n    let joined = 0;\n    AT.join.forEach((t0, k) => {\n      const f = arr(t0, GROW);\n      if (f >= 1) joined++;\n      cutLine(L0 + (k + 0.5) * W, y, H, 1 - f);       // the line between a pair shrinks away, easing in and out\n    });\n    edge(L0, y, LW, H);\n    const ac = arr(AT.joinCount), as = arr(AT.joinName, SLIDE), aa = arr(AT.joinArrow), an = arr(AT.joinNew);\n    const counted = ac > 0, named = as > 0;\n    // The count of eighths fades away as the count of quarters fades in.\n    if (ac < 1) fadeIn(countOn(y, W / 2, 6), 1 - ac, 0);\n    if (counted) fadeIn(countOn(y, W, 3), ac);\n    bigFrac(K.lerp(170, 95, as), 118, 6, 8);        // 6/8 slides aside, easing, to make room\n    if (aa > 0) arrows(122, 214, 118, '÷2', aa);\n    if (an > 0) fadeIn(bigFrac(245, 118, 3, 4), an);\n    return 'A bar of 8 eighths with 6 shaded, named 6/8' + (joined ? ', with ' + joined + ' of its 4 pairs joined into quarters' : '') +\n      (counted ? '. The 3 shaded quarters are counted' : '') + (named ? ', and the top and bottom are both divided by 2, making 3/4.' : '.');\n  }\n  function demoLine() {\n    svg.setAttribute('viewBox', '0 0 340 228');\n    const X = 60, W = 260, H = 40, ys = [4, 50, 96], rows = [[1, 2], [2, 4], [4, 8]], Y = 170, xm = X + W / 2;\n    let n = 0;\n    rows.forEach((r, j) => {\n      const a = arr(AT.line[j]);       // each bar's shading fades in, the top bar first\n      if (a > 0) n++;\n      for (let k = 0; k < r[1]; k++) { if (k < r[0]) shade(X + k * W / r[1], ys[j], W / r[1], H, a); else still(X + k * W / r[1], ys[j], W / r[1], H, false); }\n      edge(X, ys[j], W, H);\n      svgFrac(30, ys[j] + H / 2 + 2, r[0], r[1], 'lab', 'fbar');\n    });\n    svg.appendChild(K.svg('line', { class: 'axis', x1: X, y1: Y, x2: X + W, y2: Y }));\n    for (let k = 0; k <= 8; k++) {\n      const x = X + k * W / 8, h = k % 8 === 0 ? 12 : k % 2 === 0 ? 8 : 5;\n      svg.appendChild(K.svg('line', { class: 'tick', x1: x, y1: Y - h, x2: x, y2: Y + h }));\n    }\n    text(X, Y + 34, 0, 'num'); text(X + W, Y + 34, 1, 'num');\n    const f = arr(AT.lineFrom, AT.lineTo - AT.lineFrom);    // the line eases down from the shadings to the number line\n    if (f > 0) svg.appendChild(K.svg('line', { class: 'drop', x1: xm, y1: ys[0], x2: xm, y2: ys[0] + (Y - ys[0]) * f }));\n    const ad = arr(AT.lineDot), al = arr(AT.lineLabel), landed = ad > 0;\n    // The mark fades in where the line lands, growing gently from 60% to full size; then its names.\n    if (ad > 0) fadeIn(svg.appendChild(K.svg('circle', { class: 'dot', cx: xm, cy: Y, r: ad >= 1 ? 9 : 9 * (0.6 + 0.4 * ad) })), ad, 0);\n    if (al > 0) {\n      fadeIn(svgFrac(xm - 50, Y + 30, 1, 2, 'mlab', 'mbar'), al); fadeIn(text(xm - 25, Y + 35, '=', 'mlab'), al);\n      fadeIn(svgFrac(xm, Y + 30, 2, 4, 'mlab', 'mbar'), al); fadeIn(text(xm + 25, Y + 35, '=', 'mlab'), al);\n      fadeIn(svgFrac(xm + 50, Y + 30, 4, 8, 'mlab', 'mbar'), al);\n    }\n    return 'Three bars of the same length, cut into halves, quarters and eighths, with ' + n + ' of them shaded to 1/2, 2/4 and 4/8, above a number line from 0 to 1' +\n      (landed ? '. One line drops from the end of all three shadings to a single mark, labelled 1/2 = 2/4 = 4/8.' : '.');\n  }\n\n  // --- the puzzles (DO steps) ---\n  function drawCut(d, st) {\n    svg.setAttribute('viewBox', '0 0 340 64');\n    const y = 4, H = 56, n = d.given[1], W = LW / n, f = st.cut ? arr(0, AT.cut) : 0;   // the cuts grow down at once, easing in and out\n    for (let k = 0; k < n; k++) still(L0 + k * W, y, W, H, k < d.given[0]);\n    for (let k = 0; k < n; k++) cutLine(L0 + (k + 0.5) * W, y, H, f);\n    edge(L0, y, LW, H);\n    return 'A bar of ' + n + ' quarters with ' + d.given[0] + ' shaded' + (st.cut ? (f >= 1 ? ', every quarter cut in two, making 8 pieces with 2 shaded.' : ', being cut in two.') : '.');\n  }\n  function drawGap(d, st, right) {\n    svg.setAttribute('viewBox', '0 0 340 152');\n    const Yf = 36, y = 92, H = 56, W = LW / 4;\n    bigFrac(125, Yf, d.given[0], d.given[1]);\n    text(170, Yf + 8, '=', 'big');\n    if (st.pick == null) svg.appendChild(K.svg('rect', { class: 'gapbox', x: 201, y: Yf - 29, width: 28, height: 26, rx: 4 }));\n    else text(215, Yf - 5, st.pick, 'big');\n    svg.appendChild(K.svg('line', { class: 'bbar', x1: 202, y1: Yf, x2: 228, y2: Yf }));\n    text(215, Yf + 24, d.bottom, 'big');\n    for (let k = 0; k < 4; k++) still(L0 + k * W, y, W, H, k < d.given[0]);\n    if (right) {               // once right, every quarter's cut grows down the bar, then the eighths are counted\n      const f = arr(REVEAL.cut, GROW), ac = arr(REVEAL.count);\n      for (let k = 0; k < 4; k++) cutLine(L0 + (k + 0.5) * W, y, H, f);\n      if (ac > 0) fadeIn(countOn(y, W / 2, 6), ac);\n    }\n    edge(L0, y, LW, H);\n    return d.given[0] + '/' + d.given[1] + ' = ' + (st.pick == null ? 'a gap' : st.pick) + '/' + d.bottom + ', above a bar of 4 quarters with 3 shaded' +\n      (right ? ', now cut into 8 eighths with 6 shaded.' : '.');\n  }\n  // Two bars of the same length: the given fraction, and (once checked) the picked one under it.\n  function drawPick(d, st) {\n    svg.setAttribute('viewBox', '0 0 340 132');\n    const X = 56, W = 264, H = 46, r1 = 6, r2 = 78;\n    const shown = (st.res === 'right' || st.res === 'wrong') && st.pick != null, p = shown ? parse(st.pick) : null;\n    // Once checked, the picked bar fades in over the empty one (its ? fading away), then a line eases\n    // down from the end of the given shading.\n    const a = shown ? arr(REVEAL.bar) : 0, g = shown ? arr(REVEAL.drop, GROW) : 0;\n    svgFrac(26, r1 + H / 2 + 2, d.given[0], d.given[1], 'lab', 'fbar');\n    barOf(X, r1, W, H, d.given[0], d.given[1]);\n    if (a < 1) svg.appendChild(K.svg('rect', { class: 'blank', x: X, y: r2, width: W, height: H }));\n    if (a > 0) { fadeIn(svgFrac(26, r2 + H / 2 + 2, p[0], p[1], 'lab', 'fbar'), a); fadeIn(barOf(X, r2, W, H, p[0], p[1]), a, 0); }\n    if (a < 1) { const q = text(26, r2 + H / 2 + 6, '?', 'lab'); if (a > 0) fadeIn(q, 1 - a, 0); }\n    if (g > 0) { const xd = X + W * d.given[0] / d.given[1]; svg.appendChild(K.svg('line', { class: 'drop', x1: xd, y1: r1, x2: xd, y2: r1 + (r2 +